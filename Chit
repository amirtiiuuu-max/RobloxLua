        { name = "Супер дальний", offset = Vector3.new(0, 8, 20), firstPerson = false }
    }
}

function Spectate:getPlayers()
    local list = {}
    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= LocalPlayer then
            table.insert(list, v)
        end
    end
    return list
end

function Spectate:setTarget(pl)
    if not pl or not pl.Character then return false end
    self.target = pl
    local cam = workspace.CurrentCamera
    self.origCamType = cam.CameraType
    self.origCamSubj = cam.CameraSubject
    cam.CameraType = Enum.CameraType.Scriptable
    if self.conn then self.conn:Disconnect() end
    self.conn = RunService.RenderStepped:Connect(function()
        if not self.active or not self.target or not self.target.Character then
            if self.active then self:disable() end
            return
        end
        local root = self.target.Character:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local mode = self.modes[self.viewMode]
        if mode.firstPerson then
            local head = self.target.Character:FindFirstChild("Head")
            local cf = head and head.CFrame or root.CFrame
            workspace.CurrentCamera.CFrame = cf + mode.offset
        else
            local targetPos = root.CFrame.Position
            local offsetPos = targetPos + mode.offset
            workspace.CurrentCamera.CFrame = CFrame.new(offsetPos, targetPos)
        end
    end)
    return true
end

function Spectate:enable(pl)
    if self.active then return end
    local target = pl
    if not target then
        local players = self:getPlayers()
        if #players == 0 then
            warn("[Spectate] Нет других игроков для наблюдения")
            return
        end
        target = players[1]
    end
    if self:setTarget(target) then
        self.active = true
    end
end

function Spectate:disable()
    if not self.active then return end
    self.active = false
    if self.conn then
        self.conn:Disconnect()
        self.conn = nil
    end
    local cam = workspace.CurrentCamera
    cam.CameraType = self.origCamType or Enum.CameraType.Custom
    cam.CameraSubject = self.origCamSubj or LocalPlayer.Character
    self.target = nil
end

function Spectate:nextPlayer()
    if not self.active then return end
    local players = self:getPlayers()
    if #players == 0 then self:disable(); return end
    local idx = 1
    for i, p in ipairs(players) do
        if p == self.target then idx = i + 1; break end
    end
    if idx > #players then idx = 1 end
    self:setTarget(players[idx])
end

function Spectate:cycleView()
    if not self.active then return end
    self.viewMode = self.viewMode % #self.modes + 1
end

