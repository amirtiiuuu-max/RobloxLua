-- ФУНКЦИЯ 4: SHADOW (АБСОЛЮТНАЯ НЕВИДИМОСТЬ)
-- █████████████████████████████████████████████████████████████████████████████████████████████████████

local Shadow = {
    active = false,
    original_transparency = {},
    original_collide = {},
    original_speed = nil,
    original_jump = nil,
    old_players_index = nil
}

function Shadow:full_ghost()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    
    -- 1. Остановка анимаций и звуков
    if humanoid then
        for _, track in pairs(humanoid:GetPlayingAnimationTracks()) do
            track:Stop()
        end
        self.original_speed = humanoid.WalkSpeed
        self.original_jump = humanoid.JumpPower
        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid.AutoRotate = false
    end
    
    -- 2. Удаление всех инструментов/аксессуаров
    for _, child in pairs(char:GetChildren()) do
        if child:IsA("Tool") or child:IsA("Accessory") or child:IsA("Clothing") then
            child:Destroy()
        end
    end
    
    -- 3. Сделать все части прозрачными и без коллизий
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            self.original_transparency[part] = part.Transparency
            self.original_collide[part] = part.CanCollide
            part.Transparency = 1
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false
        elseif part:IsA("Decal") or part:IsA("Texture") then
            part.Transparency = 1
        elseif part:IsA("Sound") then
            part.Volume = 0
            part.Playing = false
        end
    end
    
    -- 4. Скрыть BillboardGui (имя над головой)
    local head = char:FindFirstChild("Head")
    if head then
        for _, gui in pairs(head:GetChildren()) do
            if gui:IsA("BillboardGui") then
                gui.Enabled = false
            end
        end
    end
    
    -- 5. Уничтожить HumanoidDescription (внешность)
    local hd = char:FindFirstChild("HumanoidDescription")
    if hd then
        hd:Destroy()
    end
    
    -- 6. Техника десинхронизации (заморозка для сервера)
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        local body_vel = Instance.new("BodyVelocity")
        body_vel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        body_vel.Velocity = Vector3.new(0,0,0)
        body_vel.Parent = root
        task.wait(0.2)
        body_vel:Destroy()
    end
    
    -- 7. Скрыть из списка игроков (через метатаблицу)
    local mt = getrawmetatable(Players)
    if mt and not self.old_players_index then
        self.old_players_index = mt.__index
        setreadonly(mt, false)
        mt.__index = function(t, k)
            if k == LocalPlayer then return nil end
            return self.old_players_index(t, k)
        end
        setreadonly(mt, true)
    end
    
    -- 8. Дополнительно: отключить звуки окружения, издаваемые персонажем
    local sound_service = game:GetService("SoundService")
    if sound_service then
        sound_service:GetPropertyChangedSignal("MasterVolume"):Connect(function()
            sound_service.MasterVolume = 0
        end)
    end
end

function Shadow:revert()
    local char = LocalPlayer.Character
    if char then
        for part, trans in pairs(self.original_transparency) do
            if part and part.Parent then
                part.Transparency = trans
                part.CanCollide = self.original_collide[part] or true
                part.CanTouch = true
                part.CanQuery = true
            end
        end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = self.original_speed or 16
            humanoid.JumpPower = self.original_jump or 50
            humanoid.AutoRotate = true
        end
        local head = char:FindFirstChild("Head")
        if head then
            for _, gui in pairs(head:GetChildren()) do
                if gui:IsA("BillboardGui") then
                    gui.Enabled = true
                end
            end
        end
    end
    -- Восстановить список игроков
    if self.old_players_index then
        local mt = getrawmetatable(Players)
        setreadonly(mt, false)
        mt.__index = self.old_players_index
        setreadonly(mt, true)
        self.old_players_index = nil
    end
    self.original_transparency = {}
    self.original_collide = {}
end

function Shadow:enable()
    if self.active then return end
    self.active = true
    self:full_ghost()
    -- Если камера наблюдения активна, выключаем её (конфликт)
    if Spectate.active then
        Spectate:disable()
        -- Обновим кнопку в меню позже (в блоке GUI)
    end
    LocalPlayer.CharacterAdded:Connect(function(new_char)
        task.wait(0.5)
        if Shadow.active then
            Shadow:full_ghost()
        end
    end)
    print("[Shadow] Абсолютная невидимость активирована. Ты — призрак.")
end

function Shadow:disable()
    if not self.active then return end
    self.active = false
    self:revert()
    print("[Shadow] Невидимость отключена.")
end

