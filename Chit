local AutoFarm = { active=false, conn=nil, range=50 }
function AutoFarm:collect()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local pos = char.HumanoidRootPart.Position
    for _,obj in pairs(Workspace:GetDescendants()) do
        local cd = obj:FindFirstChild("ClickDetector")
        if cd and obj:IsA("BasePart") and (obj.Position-pos).Magnitude <= self.range then
            pcall(fireclickdetector, cd)
        elseif cd and obj:IsA("Model") then
            local prim = obj:FindFirstChild("PrimaryPart") or obj:FindFirstChild("HumanoidRootPart")
            if prim and (prim.Position-pos).Magnitude <= self.range then pcall(fireclickdetector, cd) end
        end
    end
end
function AutoFarm:enable(rng)
    if self.active then return end
    self.active=true
    if rng then self.range=rng end
    self.conn = RunService.Heartbeat:Connect(function() if self.active then self:collect() end end)
    print("[AutoFarm] ON, радиус "..self.range)
end
function AutoFarm:disable()
    if not self.active then return end
    self.active=false
    if self.conn then self.conn:Disconnect(); self.conn=nil end
    print("[AutoFarm] OFF")
end

local Wallhack = { active=false, orig_mat={}, orig_trans={} }
function Wallhack:enable()
    if self.active then return end
    self.active=true
    for _,obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Material~=Enum.Material.Neon then
            if not self.orig_mat[obj] then self.orig_mat[obj]=obj.Material; self.orig_trans[obj]=obj.Transparency end
            obj.LocalTransparencyModifier = (obj.Material==Enum.Material.Concrete or obj.Material==Enum.Material.Brick) and 0.6 or 0.3
        end
    end
    local function add_hl(char)
        local hl = Instance.new("Highlight")
        hl.Name="GhostWH"; hl.FillColor=Color3.fromRGB(255,0,0); hl.FillTransparency=0.7; hl.OutlineColor=Color3.new(1,1,1); hl.OutlineTransparency=0.3
        hl.Parent=char
        char.AncestryChanged:Connect(function() if not char.Parent then hl:Destroy() end end)
    end
    for _,pl in ipairs(Players:GetPlayers()) do if pl~=LocalPlayer and pl.Character then add_hl(pl.Character) end end
    Players.PlayerAdded:Connect(function(pl) pl.CharacterAdded:Connect(function(ch) if Wallhack.active then add_hl(ch) end end) end)
    print("[Wallhack] ON")
end
function Wallhack:disable()
    if not self.active then return end
    self.active=false
    for obj,_ in pairs(self.orig_mat) do if obj and obj.Parent then obj.LocalTransparencyModifier=0 end end
    for _,hl in pairs(Workspace:GetDescendants()) do if hl:IsA("Highlight") and hl.Name=="GhostWH" then hl:Destroy() end end
    self.orig_mat={}; self.orig_trans={}
    print("[Wallhack] OFF")
end

local TimeCtrl = { active=false, conn=nil, desired=14 }
function TimeCtrl:enable(h)
    if self.active then return end
    self.active=true
    self.desired = h or 14
    self.conn = RunService.RenderStepped:Connect(function() if self.active then Lighting.ClockTime = self.desired end end)
    print("[TimeCtrl] ON")
end
function TimeCtrl:disable()
    if not self.active then return end
    self.active=false
    if self.conn then self.conn:Disconnect() end
    print("[TimeCtrl] OFF")
end
function TimeCtrl:set(h) if self.active then self.desired = math.clamp(h,0,24) end end

local AntiKick = { active=false, old_kick=nil }
function AntiKick:enable()
    if self.active then return end
    self.active=true
    local pl = LocalPlayer
    if pl and pl.Kick then self.old_kick = pl.Kick; pl.Kick = function(_,msg) if AntiKick.active then warn("[AntiKick] Заблокирован кик: "..tostring(msg)); return end return self.old_kick(_,msg) end end
    for _,r in pairs(ReplicatedStorage:GetChildren()) do
        if r:IsA("RemoteEvent") and (r.Name:lower():find("report") or r.Name:lower():find("anticheat")) then
            local old = r.FireServer
            r.FireServer = function(...) if AntiKick.active then return nil end return old(...) end
        end
    end
    print("[AntiKick] ON")
end
function AntiKick:disable()
    if not self.active then return end
    self.active=false
    if LocalPlayer and self.old_kick then LocalPlayer.Kick = self.old_kick end
    print("[AntiKick] OFF")
end

local Macro = { autoclick=false, conn=nil, delay=0.1 }
function Macro:start_autoclick(d)
    if self.autoclick then return end
    self.autoclick=true
    self.delay = d or 0.1
    self.conn = RunService.Heartbeat:Connect(function()
        if self.autoclick then
            pcall(function()
                if VirtualInput and VirtualInput.SendMouseButtonEvent then
                    VirtualInput:SendMouseButtonEvent(Enum.UserInputType.MouseButton1, Enum.UserInputState.Begin, nil)
                    task.wait(0.05)
                    VirtualInput:SendMouseButtonEvent(Enum.UserInputType.MouseButton1, Enum.UserInputState.End, nil)
                end
            end)
            task.wait(self.delay)
        end
    end)
    print("[Macro] Автоклик ON, задержка "..self.delay)
end
function Macro:stop_autoclick()
    if not self.autoclick then return end
    self.autoclick=false
    if self.conn then self.conn:Disconnect(); self.conn=nil end
    print("[Macro] Автоклик OFF")
end

