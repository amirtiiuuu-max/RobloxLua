    local modeButtons = {}
    for i, mode in ipairs(modes) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0.2, -5, 0, 25)
        btn.Position = UDim2.new(0, 10 + (i-1)*(0.2*280 - 2), 0, 275)
        btn.Text = mode == "First" and "1-е" or (mode == "Second" and "2-е" or (mode == "Third" and "3-е" or "Дал"))
        btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 12
        local modeCorner = Instance.new("UICorner")
        modeCorner.CornerRadius = UDim.new(0, 3)
        modeCorner.Parent = btn
        btn.Parent = mainFrame

        btn.MouseButton1Click:Connect(function()
            for _, b in ipairs(modeButtons) do
                b.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            end
            btn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
            Tracking.setMode(mode)
            if watchEnabled and Gui.selectedPlayer then
                watchToggle.Text = "Слежение: ВКЛ (" .. Gui.selectedPlayer.Name .. ") " .. mode
            end
        end)
        table.insert(modeButtons, btn)
        if mode == "Third" then
            btn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
        end
    end

    -- === НОВЫЕ КНОПКИ ТРОЛЛИНГА ===
    local screamerButton = Instance.new("TextButton")
    screamerButton.Size = UDim2.new(1, -20, 0, 35)
    screamerButton.Position = UDim2.new(0, 10, 0, 310)   -- ниже всех
    screamerButton.Text = "Скример на цель"
    screamerButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    screamerButton.TextColor3 = Color3.fromRGB(255, 100, 100)
    screamerButton.Font = Enum.Font.Gotham
    screamerButton.TextSize = 14
    local scrCorner = Instance.new("UICorner")
    scrCorner.CornerRadius = UDim.new(0, 4)
    scrCorner.Parent = screamerButton
    screamerButton.Parent = mainFrame
    screamerButton.MouseButton1Click:Connect(function()
        if not Gui.selectedPlayer then
            warn("[DeltaPhantom] Выберите цель для скримера.")
            return
        end
        Trolling.screamer(Gui.selectedPlayer.Name)
    end)

    local lagButton = Instance.new("TextButton")
    lagButton.Size = UDim2.new(1, -20, 0, 35)
    lagButton.Position = UDim2.new(0, 10, 0, 350)
    lagButton.Text = "Залаговать цель"
    lagButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    lagButton.TextColor3 = Color3.fromRGB(255, 150, 100)
    lagButton.Font = Enum.Font.Gotham
    lagButton.TextSize = 14
    local lagCorner = Instance.new("UICorner")
    lagCorner.CornerRadius = UDim.new(0, 4)
    lagCorner.Parent = lagButton
    lagButton.Parent = mainFrame
    lagButton.MouseButton1Click:Connect(function()
        if not Gui.selectedPlayer then
            warn("[DeltaPhantom] Выберите цель для лаг-атаки.")
            return
        end
        Trolling.lagTarget(Gui.selectedPlayer.Name)
    end)

    -- Кнопка сворачивания (прежняя, позиция скорректирована)
    local toggleButton = Instance.new("TextButton")
    toggleButton.Size = UDim2.new(0, 30, 0, 30)
    toggleButton.Position = UDim2.new(0, mainFrame.Size.X.Offset - 30, 0, 5)
    toggleButton.Text = "−"
    toggleButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleButton.Font = Enum.Font.GothamBold
    toggleButton.TextSize = 20
    local toggleCorner = Instance.new("UICorner")
    toggleCorner.CornerRadius = UDim.new(0, 4)
    toggleCorner.Parent = toggleButton
    toggleButton.Parent = mainFrame

    local menuExpanded = true
    local expandedPosition = UDim2.new(0, 10, 0.5, -250)
    local collapsedPosition = UDim2.new(0, -(mainFrame.Size.X.Offset - 30), 0.5, -250)

    toggleButton.MouseButton1Click:Connect(function()
        if menuExpanded then
            tweenPos(mainFrame, collapsedPosition, 0.3)
            toggleButton.Text = "+"
            menuExpanded = false
        else
            tweenPos(mainFrame, expandedPosition, 0.3)
            toggleButton.Text = "−"
            menuExpanded = true
        end
    end)

    -- Анимация первого появления
    tweenPos(mainFrame, expandedPosition, 0.5, function()
        print("[DeltaPhantom v1.2] Меню готово.")
    end)

    Gui.screenGui = screenGui
    Gui.mainFrame = mainFrame
    Gui.invisButton = invisButton
    Gui.watchToggle = watchToggle
    Gui.playerDropdown = playerDropdown
end

-- ===================== ОБРАБОТЧИКИ ПЕРЕРОЖДЕНИЯ =====================
LocalPlayer.CharacterAdded:Connect(function(character)
    if invisEnabled then
        -- Персонаж новый, нужно вернуть его в Workspace? Он же только что создался.
        -- Наша абсолютная невидимость работает так: при включении старый персонаж был убран.
        -- При перерождении новый персонаж автоматически в Workspace, нам нужно его снова спрятать.
        -- Поэтому просто выключаем и включаем невидимость, чтобы корректно спрятать новый.
        Invisibility.disable()
        Invisibility.enable()
    end
end)

