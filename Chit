local function hide_executor_traces()
    local g = getgenv()
    local dangerous = { "syn", "krnl", "scriptware", "delta", "protosmasher", "unc", "identifyexecutor", "getexecutorname", "isexecutor", "check" }
    for _, n in ipairs(dangerous) do if g[n] then g[n] = nil end end
    local mt = getrawmetatable(game)
    if mt then
        local old_nc = mt.__namecall
        local old_idx = mt.__index
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local m = getnamecallmethod()
            if m == "FireServer" then
                local a = { ... }
                if type(a[1]) == "string" and a[1]:lower():find("executor") then return nil end
            end
            return old_nc(self, ...)
        end)
        mt.__index = newcclosure(function(t, k)
            if k == "Platform" or k == "PlatformName" then return "Roblox" end
            if k == "Executor" or k == "ExecutionIdentity" then return nil end
            return old_idx(t, k)
        end)
        setreadonly(mt, true)
    end
end

local function kill_telemetry()
    for _, s in ipairs({ "TelemetryService", "AnalyticsService", "CrashReportService", "BugReport", "PerformanceTracker", "LogService", "StatsService" }) do
        local sv = game:FindFirstChild(s)
        if sv then sv:Destroy() end
    end
    local http = game:GetService("HttpService")
    if http then
        local old_post = http.PostAsync
        local old_get = http.GetAsync
        http.PostAsync = function(self, url, data, ...)
            if type(url) == "string" and (url:find("telemetry") or url:find("analytics") or url:find("report")) then return "" end
            return old_post(self, url, data, ...)
        end
        http.GetAsync = function(self, url, ...)
            if type(url) == "string" and (url:find("telemetry") or url:find("analytics")) then return "" end
            return old_get(self, url, ...)
        end
    end
    local stats = game:GetService("Stats")
    if stats and stats.Network then
        stats.Network:GetPropertyChangedSignal("OutgoingKBps"):Connect(function() stats.Network.OutgoingKBps = 0 end)
        stats.Network:GetPropertyChangedSignal("IncomingKBps"):Connect(function() stats.Network.IncomingKBps = 0 end)
    end
end

