local ChatSpy = { active = false, conns = {}, oldFire = nil, remote = nil }

function ChatSpy:enable()
    if self.active then return end
    self.active = true
    local rep = ReplicatedStorage
    local remote = rep:FindFirstChild("DefaultChatSystemChatEvents") or rep:FindFirstChild("SayMessageRequest") or rep:FindFirstChild("Chatted")
    if remote and remote:IsA("RemoteEvent") then
        self.remote = remote
        self.oldFire = remote.FireServer
        remote.FireServer = function(...)
            local args = { ... }
            if #args >= 1 and type(args[1]) == "string" then
                print("[CHAT SENT] " .. LocalPlayer.Name .. ": " .. args[1])
            end
            if self.oldFire then return self.oldFire(...) end
        end
    end
    local onMsg = rep:FindFirstChild("OnChatMessage")
    if onMsg and onMsg:IsA("RemoteEvent") then
        table.insert(self.conns, onMsg.OnClientEvent:Connect(function(pl, msg)
            if self.active and pl ~= LocalPlayer then
                print("[CHAT] " .. pl.Name .. ": " .. msg)
            end
        end))
    end
    local txtChat = game:GetService("TextChatService")
    if txtChat then
        local channels = txtChat:FindFirstChild("TextChannels")
        if channels then
            for _, ch in pairs(channels:GetChildren()) do
                if ch:IsA("TextChannel") then
                    table.insert(self.conns, ch.OnMessageReceived:Connect(function(m)
                        if self.active and m.FromSpeaker ~= LocalPlayer then
                            print("[CHAT] " .. m.FromSpeaker.Name .. ": " .. m.Text)
                        end
                    end))
                end
            end
        end
    end
end

function ChatSpy:disable()
    if not self.active then return end
    self.active = false
    for _, c in ipairs(self.conns) do c:Disconnect() end
    self.conns = {}
    if self.remote and self.oldFire then
        self.remote.FireServer = self.oldFire
        self.oldFire = nil
        self.remote = nil
    end
end

