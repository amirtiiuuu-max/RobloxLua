local function create_state_button(parent, text, default_state, callback)
    -- Создаёт кнопку, которая меняет цвет и текст при нажатии
    -- callback(current_state) вызывается при каждом изменении
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 44)
    btn.BackgroundColor3 = default_state and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(100, 35, 35)
    btn.BackgroundTransparency = 0.15
    btn.Text = text .. (default_state and " [ON]" or " [OFF]")
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 14
    btn.Parent = parent
    
    local corner_btn = Instance.new("UICorner")
    corner_btn.CornerRadius = UDim.new(0, 8)
    corner_btn.Parent = btn
    
    local current_state = default_state
    btn.MouseButton1Click:Connect(function()
        current_state = not current_state
        btn.BackgroundColor3 = current_state and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(100, 35, 35)
        btn.Text = text .. (current_state and " [ON]" or " [OFF]")
        callback(current_state)
    end)
    return btn
end

