local ChatSpy = { active=false, conns={} }
function ChatSpy:enable()
    if self.active then return end
    self.active = true
    local rep = ReplicatedStorage
    local remote = rep:FindFirstChild("DefaultChatSystemChatEvents") or rep:FindFirstChild("SayMessageRequest") or rep:FindFirstChild("Chatted")
    if remote and remote:IsA("RemoteEvent") then
        self.old_fire = remote.FireServer
        remote.FireServer = function(...) return self.old_fire(...) end
    end
    local chat_remote = rep:FindFirstChild("OnChatMessage")
    if chat_remote and chat_remote:IsA("RemoteEvent") then
        table.insert(self.conns, chat_remote.OnClientEvent:Connect(function(ply,msg)
            if self.active then print("[CHAT] "..ply.Name..": "..msg) end
        end))
    end
    local txt = game:GetService("TextChatService")
    if txt then
        for _,ch in pairs(txt.TextChannels:GetChildren()) do
            table.insert(self.conns, ch.OnMessageReceived:Connect(function(m)
                if self.active and m.FromSpeaker ~= LocalPlayer then print("[CHAT] "..m.FromSpeaker.Name..": "..m.Text) end
            end))
        end
    end
    print("[ChatSpy] ON")
end
function ChatSpy:disable()
    if not self.active then return end
    self.active = false
    for _,c in ipairs(self.conns) do c:Disconnect() end
    self.conns = {}
    if self.old_fire and self.remote then self.remote.FireServer = self.old_fire end
    print("[ChatSpy] OFF")
end

local Spectate = { active=false, target=nil, conn=nil, offs=Vector3.new(0,2.5,0) }
function Spectate:get_players()
    local list={}
    for _,v in ipairs(Players:GetPlayers()) do if v~=LocalPlayer then table.insert(list,v) end end
    return list
end
function Spectate:set_target(pl)
    if not pl or not pl.Character then return false end
    self.target = pl
    local cam = workspace.CurrentCamera
    self.orig_type = cam.CameraType
    self.orig_subj = cam.CameraSubject
    cam.CameraType = Enum.CameraType.Scriptable
    if self.conn then self.conn:Disconnect() end
    self.conn = RunService.RenderStepped:Connect(function()
        if not self.active or not self.target or not self.target.Character then self:disable(); return end
        local root = self.target.Character:FindFirstChild("HumanoidRootPart")
        if root then workspace.CurrentCamera.CFrame = root.CFrame + self.offs end
    end)
    return true
end
function Spectate:enable(pl)
    if self.active then return end
    local target = pl or self:get_players()[1]
    if not target then warn("[Spectate] Нет игроков"); return end
    if self:set_target(target) then self.active=true; print("[Spectate] Наблюдение за "..target.Name) end
end
function Spectate:disable()
    if not self.active then return end
    self.active=false
    if self.conn then self.conn:Disconnect() end
    local cam = workspace.CurrentCamera
    cam.CameraType = self.orig_type or Enum.CameraType.Custom
    cam.CameraSubject = self.orig_subj or LocalPlayer.Character
    self.target=nil
    print("[Spectate] OFF")
end
function Spectate:next()
    if not self.active then warn("Сначала включи камеру"); return end
    local pls = self:get_players()
    if #pls==0 then self:disable(); return end
    local idx=1
    for i,p in ipairs(pls) do if p==self.target then idx=i+1; break end end
    if idx>#pls then idx=1 end
    self:set_target(pls[idx])
    print("[Spectate] Теперь "..self.target.Name)
end

local Teleport = {}
function Teleport:to_player(pl)
    if not pl or not pl.Character then return false end
    local char = LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    local troot = pl.Character:FindFirstChild("HumanoidRootPart")
    if root and troot then root.CFrame = troot.CFrame + Vector3.new(0,2,0); task.wait(); root.Velocity=Vector3.new(0,0,0); return true end
    return false
end
function Teleport:to_coords(x,y,z)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then root.CFrame = CFrame.new(x,y,z); task.wait(); root.Velocity=Vector3.new(0,0,0) end
end
function Teleport:random()
    local pls={}
    for _,v in ipairs(Players:GetPlayers()) do if v~=LocalPlayer and v.Character then table.insert(pls,v) end end
    if #pls>0 then self:to_player(pls[math.random(#pls)]) else warn("Нет игроков") end
end

local Shadow = { active=false, orig_trans={}, orig_coll={}, old_speed=nil, old_jump=nil, old_idx=nil }
function Shadow:full()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        for _,t in pairs(hum:GetPlayingAnimationTracks()) do t:Stop() end
        self.old_speed = hum.WalkSpeed; self.old_jump = hum.JumpPower
        hum.WalkSpeed=0; hum.JumpPower=0; hum.AutoRotate=false
    end
    for _,child in pairs(char:GetChildren()) do
        if child:IsA("Tool") or child:IsA("Accessory") or child:IsA("Clothing") then child:Destroy() end
    end
    for _,part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            self.orig_trans[part]=part.Transparency; self.orig_coll[part]=part.CanCollide
            part.Transparency=1; part.CanCollide=false; part.CanTouch=false; part.CanQuery=false
        elseif part:IsA("Decal") or part:IsA("Texture") then part.Transparency=1
        elseif part:IsA("Sound") then part.Volume=0; part.Playing=false end
    end
    local head = char:FindFirstChild("Head")
    if head then for _,g in pairs(head:GetChildren()) do if g:IsA("BillboardGui") then g.Enabled=false end end end
    local hd = char:FindFirstChild("HumanoidDescription")
    if hd then hd:Destroy() end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
        bv.Velocity = Vector3.new(0,0,0)
        bv.Parent = root
        task.wait(0.2)
        bv:Destroy()
    end
    local mt = getrawmetatable(Players)
    if mt and not self.old_idx then
        self.old_idx = mt.__index
        setreadonly(mt, false)
        mt.__index = function(t,k) if k==LocalPlayer then return nil end return self.old_idx(t,k) end
        setreadonly(mt, true)
    end
end
function Shadow:revert()
    local char = LocalPlayer.Character
    if char then
        for part,trans in pairs(self.orig_trans) do if part and part.Parent then part.Transparency=trans; part.CanCollide=self.orig_coll[part] or true; part.CanTouch=true; part.CanQuery=true end end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed=self.old_speed or 16; hum.JumpPower=self.old_jump or 50; hum.AutoRotate=true end
        local head = char:FindFirstChild("Head")
        if head then for _,g in pairs(head:GetChildren()) do if g:IsA("BillboardGui") then g.Enabled=true end end end
    end
    if self.old_idx then
        local mt = getrawmetatable(Players)
        setreadonly(mt, false)
        mt.__index = self.old_idx
        setreadonly(mt, true)
        self.old_idx=nil
    end
    self.orig_trans={}; self.orig_coll={}
end
function Shadow:enable()
    if self.active then return end
    self.active=true
    self:full()
    LocalPlayer.CharacterAdded:Connect(function() if Shadow.active then task.wait(0.5); Shadow:full() end end)
    print("[Shadow] Абсолютная невидимость включена")
end
function Shadow:disable()
    if not self.active then return end
    self.active=false
    self:revert()
    print("[Shadow] Невидимость выключена")
end

