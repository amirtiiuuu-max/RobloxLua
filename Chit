    label.TextColor3 = Color3.fromRGB(220, 220, 240)
    label.Font = Enum.Font.Gotham
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame
    
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0.4, 0, 0, 28)
    box.Position = UDim2.new(0, 0, 0, 28)
    box.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    box.Text = tostring(default_val)
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.Font = Enum.Font.Gotham
    box.TextSize = 13
    box.Parent = frame
    local corner_box = Instance.new("UICorner")
    corner_box.CornerRadius = UDim.new(0, 6)
    corner_box.Parent = box
    
    box.FocusLost:Connect(function()
        local num = tonumber(box.Text)
        if num then
            num = math.clamp(num, min_val, max_val)
            box.Text = tostring(num)
            label.Text = text .. ": " .. tostring(num)
            callback(num)
        else
            box.Text = tostring(default_val)
        end
    end)
    return frame
end

