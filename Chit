-- 8.9 Специфичный эксплойт для Rocket Wars / Ракетные войны
function Zeus.rocketWarsSpecific()
    -- Попытка найти внутреннюю переменную "Currency" в игре
    local playerGui = localPlayer.PlayerGui
    local mainGui = playerGui:FindFirstChild("MainGUI") or playerGui:FindFirstChild("GameGUI")
    if mainGui then
        local currencyLabel = mainGui:FindFirstChild("CurrencyLabel") or mainGui:FindFirstChild("MoneyText")
        if currencyLabel and currencyLabel:IsA("TextLabel") then
            -- Зациклить значение
            spawn(function()
                while Zeus.isActive do
                    pcall(function() currencyLabel.Text = "∞" end)
                    task.wait(0.5)
                end
            end)
        end
    end
    -- Изменить значение в локальной таблице игры
    if _G and _G.PlayerData then
        _G.PlayerData.Money = 9e99
    end
    if shared and shared.PlayerCurrency then
        shared.PlayerCurrency = 1e308
    end
end

