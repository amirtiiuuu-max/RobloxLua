-- ФУНКЦИЯ 8: ANTI-KICK + BLOCK REPORTS (ЗАЩИТА ОТ КИКОВ И РЕПОРТОВ)
-- █████████████████████████████████████████████████████████████████████████████████████████████████████

local AntiKick = {
    active = false,
    old_kick = nil
}

function AntiKick:enable()
    if self.active then return end
    self.active = true
    -- Перехват kick
    local plr = LocalPlayer
    if plr and plr.Kick then
        self.old_kick = plr.Kick
        plr.Kick = function(self, msg)
            if AntiKick.active then
                warn("[AntiKick] Заблокирован кик: " .. tostring(msg))
                return
            end
            return self.old_kick(self, msg)
        end
    end
    -- Блокировка репорт удалённых событий
    local function block_report_remote(remote)
        if remote and remote:IsA("RemoteEvent") and (remote.Name:lower():find("report") or remote.Name:lower():find("anticheat")) then
            local old_fire = remote.FireServer
            remote.FireServer = function(...)
                if AntiKick.active then
                    return nil
                end
                return old_fire(...)
            end
        end
    end
    for _, remote in pairs(ReplicatedStorage:GetChildren()) do
        block_report_remote(remote)
    end
    print("[AntiKick] Защита включена. Кики и репорты блокируются.")
end

function AntiKick:disable()
    if not self.active then return end
    self.active = false
    if LocalPlayer and self.old_kick then
        LocalPlayer.Kick = self.old_kick
        self.old_kick = nil
    end
    print("[AntiKick] Защита выключена.")
end

