-- █████████████████████████████████████████████████████████████████████████████████████████████████████

local MacroSystem = {
    autoclick_active = false,
    auto_click_connection = nil,
    click_delay = 0.1
}

function MacroSystem:start_autoclick(delay)
    if self.autoclick_active then return end
    self.autoclick_active = true
    self.click_delay = delay or 0.1
    self.auto_click_connection = RunService.Heartbeat:Connect(function()
        if self.autoclick_active then
            pcall(function()
                -- Симулируем клик мыши (если executor поддерживает)
                if VirtualInput and VirtualInput.SendMouseButtonEvent then
                    VirtualInput:SendMouseButtonEvent(Enum.UserInputType.MouseButton1, Enum.UserInputState.Begin, nil)
                    task.wait(0.05)
                    VirtualInput:SendMouseButtonEvent(Enum.UserInputType.MouseButton1, Enum.UserInputState.End, nil)
                else
                    -- Альтернатива: fireclickdetector на том, под чем курсор (но сложно)
                    -- Просто имитируем нажатие через UserInputService (не всегда работает)
                end
            end)
            task.wait(self.click_delay)
        end
    end)
    print("[Macro] Автоклик включён, задержка " .. self.click_delay .. " сек.")
end

function MacroSystem:stop_autoclick()
    if not self.autoclick_active then return end
    self.autoclick_active = false
    if self.auto_click_connection then
        self.auto_click_connection:Disconnect()
        self.auto_click_connection = nil
    end
    print("[Macro] Автоклик выключен.")
end

