local function hide_executor_traces()
    local g = getgenv()
    local dangerous = {"syn","krnl","scriptware","delta","protosmasher","unc","identifyexecutor","getexecutorname","isexecutor","check"}
    for _, name in ipairs(dangerous) do if g[name] then g[name]=nil end end
    local mt = getrawmetatable(game)
    if mt then
        local old_namecall = mt.__namecall
        local old_index = mt.__index
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self,...)
            local method = getnamecallmethod()
            if method == "FireServer" then
                local args={...}
                if type(args[1])=="string" and args[1]:lower():find("executor") then return nil end
            end
            return old_namecall(self,...)
        end)
        mt.__index = newcclosure(function(t,k)
            if k=="Platform" or k=="PlatformName" then return "Roblox" end
            if k=="Executor" or k=="ExecutionIdentity" then return nil end
            return old_index(t,k)
        end)
        setreadonly(mt, true)
    end
end

local function kill_telemetry()
    for _,svc in ipairs({"TelemetryService","AnalyticsService","CrashReportService","BugReport","PerformanceTracker","LogService","StatsService"}) do
        local s = game:FindFirstChild(svc)
        if s then s:Destroy() end
    end
    local http = game:GetService("HttpService")
    if http then
        local old_post = http.PostAsync
        local old_get = http.GetAsync
        http.PostAsync = function(self,url,data,...)
            if type(url)=="string" and (url:find("telemetry") or url:find("analytics") or url:find("report")) then return "" end
            return old_post(self,url,data,...)
        end
        http.GetAsync = function(self,url,...)
            if type(url)=="string" and (url:find("telemetry") or url:find("analytics")) then return "" end
            return old_get(self,url,...)
        end
    end
    local stats = game:GetService("Stats")
    if stats and stats.Network then
        stats.Network:GetPropertyChangedSignal("OutgoingKBps"):Connect(function() stats.Network.OutgoingKBps=0 end)
        stats.Network:GetPropertyChangedSignal("IncomingKBps"):Connect(function() stats.Network.IncomingKBps=0 end)
    end
end

local function fake_player_identity()
    local players = game:GetService("Players")
    local lp = players.LocalPlayer
    if lp then
        lp.MembershipType = Enum.MembershipType.None
        if lp:FindFirstChild("UserId") then lp.UserId=0 end
        if lp:FindFirstChild("ClientId") then lp.ClientId.Value=math.random(1000000,9999999) end
        for _,v in pairs(lp:GetChildren()) do
            if v:IsA("LocalScript") and (v.Name:lower():find("anticheat") or v.Name:lower():find("anti-cheat")) then v:Destroy() end
        end
    end
    local rep = game:GetService("ReplicatedStorage")
    if rep then
        for _,v in pairs(rep:GetChildren()) do
            if (v:IsA("RemoteEvent") or v:IsA("RemoteFunction")) and (v.Name:lower():find("anti") or v.Name:lower():find("cheat") or v.Name:lower():find("report")) then
                v:Destroy()
            end
        end
    end
end

local function hide_console_output()
    local old_print = print
    local old_warn = warn
    print = function(...)
        local str = table.concat({...}," ")
        if str:find("Executor") or str:find("Cheat") or str:find("exploit") or str:find("hack") then return end
        old_print(...)
    end
    warn = function() end
end

local function init_antidetect()
    hide_executor_traces()
    kill_telemetry()
    fake_player_identity()
    hide_console_output()
    task.spawn(function() while true do task.wait(5) fake_player_identity() end end)
end

