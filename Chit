-- ===================== УТИЛИТЫ =====================
local function safeFind(instance, name)
    local success, result = pcall(function()
        return instance:FindFirstChild(name)
    end)
    return success and result or nil
end

local function deepHide(instance)
    if instance:IsA("GuiObject") then
        instance.Visible = false
    end
    for _, child in ipairs(instance:GetChildren()) do
        deepHide(child)
    end
end

local function tweenPos(guiObject, targetPosition, duration, callback)
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(guiObject, tweenInfo, {Position = targetPosition})
    tween:Play()
    if callback then
        tween.Completed:Connect(function()
            callback()
        end)
    end
    table.insert(tweenObjects, tween)
    return tween
end

-- ===================== АБСОЛЮТНАЯ НЕВИДИМОСТЬ (v1.2) =====================
local Invisibility = {}
Invisibility.originalTransparencies = {}
Invisibility.originalBillboardStates = {}

function Invisibility.enable()
    if invisEnabled then return end

    local character = LocalPlayer.Character
    if not character then
        local conn
        conn = LocalPlayer.CharacterAdded:Connect(function(char)
            conn:Disconnect()
            Invisibility.enable()
        end)
        return
    end

    invisEnabled = true

    -- Сохраняем позицию и создаём якорь
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp then
        local anchor = Instance.new("Part")
        anchor.Name = "InvisAnchor"
        anchor.Anchored = true
        anchor.CanCollide = false
        anchor.Transparency = 1
        anchor.Size = Vector3.new(2, 2, 2)
        anchor.Position = hrp.Position
        anchor.Parent = Workspace
        invisAnchorPart = anchor

        -- Привязываем камеру к якорю
        local camera = workspace.CurrentCamera
        camera.CameraSubject = anchor
    end

    -- Удаляем персонажа из мира (но сохраняем ссылку)
    character.Parent = nil
    -- Соединение для восстановления при перерождении отключено, т.к. мы сами управляем

    Invisibility.hideUIElements()
    print("[DeltaPhantom] Абсолютная невидимость активирована (персонаж удалён из Workspace).")
end

function Invisibility.hideUIElements()
    local playerList = safeFind(CoreGui:FindFirstChild("RobloxGui"), "PlayerList")
    if playerList then
        Invisibility.originalPlayerListEnabled = playerList.Enabled
        playerList.Enabled = false
    end

    local pauseMenu = safeFind(CoreGui:FindFirstChild("RobloxGui"), "PauseMenu")
    if pauseMenu then
        Invisibility.originalPauseMenuVisible = pauseMenu.Visible
        deepHide(pauseMenu)
    end

    local topBar = safeFind(CoreGui:FindFirstChild("RobloxGui"), "TopBar")
    if topBar then
        Invisibility.originalTopBarVisible = topBar.Visible
        topBar.Visible = false
    end
end

function Invisibility.disable()
    if not invisEnabled then return end
    invisEnabled = false

    -- Возвращаем персонажа в мир
    local character = LocalPlayer.Character
    if character and not character:IsDescendantOf(Workspace) then
        character.Parent = Workspace
        -- Устанавливаем позицию обратно на якорь
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp and invisAnchorPart then
            hrp.CFrame = invisAnchorPart.CFrame
        end
    end

    -- Удаляем якорь
    if invisAnchorPart then
        invisAnchorPart:Destroy()
        invisAnchorPart = nil
    end

    -- Восстанавливаем камеру
    local camera = workspace.CurrentCamera
    camera.CameraSubject = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")

    -- Восстанавливаем UI
    if Invisibility.originalPlayerListEnabled ~= nil then
        local playerList = safeFind(CoreGui:FindFirstChild("RobloxGui"), "PlayerList")
        if playerList then
            playerList.Enabled = Invisibility.originalPlayerListEnabled
        end
        Invisibility.originalPlayerListEnabled = nil
    end
    if Invisibility.originalPauseMenuVisible ~= nil then
        local pauseMenu = safeFind(CoreGui:FindFirstChild("RobloxGui"), "PauseMenu")
        if pauseMenu then
            pauseMenu.Visible = Invisibility.originalPauseMenuVisible
        end
        Invisibility.originalPauseMenuVisible = nil
    end
    if Invisibility.originalTopBarVisible ~= nil then
        local topBar = safeFind(CoreGui:FindFirstChild("RobloxGui"), "TopBar")
        if topBar then
            topBar.Visible = Invisibility.originalTopBarVisible
        end
        Invisibility.originalTopBarVisible = nil
    end

    print("[DeltaPhantom] Невидимость отключена.")
end

-- ===================== СЛЕЖЕНИЕ =====================
local Tracking = {}
Tracking.currentConnection = nil
Tracking.mouseWheelConnection = nil

function Tracking.enable(targetPlayerName)
    if watchEnabled then
        watchTarget = Players:FindFirstChild(targetPlayerName)
        if not watchTarget then
            warn("[DeltaPhantom] Игрок " .. targetPlayerName .. " не найден.")
            return
        end
        print("[DeltaPhantom] Цель слежения изменена на " .. watchTarget.Name)
        return
    end

    local target = Players:FindFirstChild(targetPlayerName)
    if not target then
        warn("[DeltaPhantom] Игрок не найден, слежение не запущено.")
        return
    end

    watchTarget = target
    watchEnabled = true

    local camera = workspace.CurrentCamera
    camera.CameraType = Enum.CameraType.Scriptable

    Tracking.currentConnection = RunService.RenderStepped:Connect(function(deltaTime)
        if not watchEnabled or not watchTarget then
            return
        end

        local character = watchTarget.Character
        if not character then
            return
        end

        local head = character:FindFirstChild("Head")
        local humanoidRoot = character:FindFirstChild("HumanoidRootPart")
        if not head or not humanoidRoot then
            return
        end

        local targetPosition = humanoidRoot.Position
        local targetLookVector = head.CFrame.LookVector

        local desiredCFrame
        if watchMode == "First" then
            desiredCFrame = head.CFrame * CFrame.new(0, 0.1, 0)
        elseif watchMode == "Second" then
            local behind = head.CFrame * CFrame.new(0, 0, 5)
            desiredCFrame = CFrame.lookAt(behind.Position, head.Position)
        elseif watchMode == "Third" then
            local offset = (head.CFrame.LookVector * -zoomDistance) + Vector3.new(0, 3, 0)
            local camPos = head.Position + offset
            desiredCFrame = CFrame.lookAt(camPos, head.Position)
        elseif watchMode == "Far" then
            local offset = (head.CFrame.LookVector * -zoomDistance) + Vector3.new(0, 4, 0)
            local camPos = head.Position + offset
            desiredCFrame = CFrame.lookAt(camPos, head.Position)
        end

        local currentCFrame = camera.CFrame
        local smoothCFrame = currentCFrame:Lerp(desiredCFrame, 0.2)
        camera.CFrame = smoothCFrame
    end)

    Tracking.mouseWheelConnection = UserInputService.InputChanged:Connect(function(input)
        if not watchEnabled then return end
        if input.UserInputType == Enum.UserInputType.MouseWheel then
            if watchMode == "Third" or watchMode == "Far" then
                zoomDistance = zoomDistance - input.Position.Z * 0.1
                zoomDistance = math.clamp(zoomDistance, 1, 100)
            end
        end
    end)

    print("[DeltaPhantom] Слежение за " .. watchTarget.Name .. " активировано. Режим: " .. watchMode)
end

function Tracking.disable()
    if not watchEnabled then return end
    watchEnabled = false

    if Tracking.currentConnection then
        Tracking.currentConnection:Disconnect()
        Tracking.currentConnection = nil
    end
    if Tracking.mouseWheelConnection then
        Tracking.mouseWheelConnection:Disconnect()
        Tracking.mouseWheelConnection = nil
    end

    local camera = workspace.CurrentCamera
    camera.CameraType = Enum.CameraType.Custom
    camera.CameraSubject = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")

    watchTarget = nil
    print("[DeltaPhantom] Слежение отключено.")
end

function Tracking.setMode(mode)
    if mode == "First" or mode == "Second" or mode == "Third" or mode == "Far" then
        watchMode = mode
        if mode == "First" or mode == "Second" then
            zoomDistance = 5
        elseif mode == "Third" then
            zoomDistance = 10
        elseif mode == "Far" then
            zoomDistance = 5
        end
        print("[DeltaPhantom] Режим слежения изменён на " .. mode)
    end
end

-- ===================== ТЕЛЕПОРТ =====================
local function teleportToPlayer(targetName)
    local target = Players:FindFirstChild(targetName)
    if not target then
        warn("[DeltaPhantom] Игрок не найден для телепорта.")
        return
    end

    local targetCharacter = target.Character
    if not targetCharacter then
        warn("[DeltaPhantom] Персонаж цели не загружен.")
        return
    end

    local targetHRP = targetCharacter:FindFirstChild("HumanoidRootPart")
    if not targetHRP then
        warn("[DeltaPhantom] У цели нет HumanoidRootPart.")
        return
    end

    local localCharacter = LocalPlayer.Character
    if not localCharacter then
        warn("[DeltaPhantom] Ваш персонаж не загружен.")
        return
    end

    local localHRP = localCharacter:FindFirstChild("HumanoidRootPart")
    if not localHRP then
        warn("[DeltaPhantom] Нет HumanoidRootPart у своего персонажа.")
        return
    end

    localHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 3, 0)
    print("[DeltaPhantom] Телепортирован к " .. targetName)
end

-- ===================== ТРОЛЛИНГ (v1.2) =====================
local Trolling = {}

-- Универсальный поиск RemoteEvent, подходящего для GUI/звуков
local function findSuitableRemoteEvent(keywords)
    local found = {}
    local function scan(parent)
        for _, obj in ipairs(parent:GetChildren()) do
            if obj:IsA("RemoteEvent") then
                for _, kw in ipairs(keywords) do
                    if obj.Name:lower():find(kw:lower()) then
                        table.insert(found, obj)
                        break
                    end
                end
            end
            if obj:IsA("Folder") or obj:IsA("Model") or obj:IsA("Configuration") then
                scan(obj)
            end
        end
    end
    scan(ReplicatedStorage)
    if #found == 0 then
        scan(workspace)   -- иногда RemoteEvent лежат в Workspace
    end
    return found
end

function Trolling.screamer(targetName)
    local target = Players:FindFirstChild(targetName)
    if not target then
        warn("[DeltaPhantom] Цель для скримера не найдена.")
        return
    end

    -- Ищем RemoteEvent, отвечающий за GUI/уведомления
    local guiEvents = findSuitableRemoteEvent({"gui", "notification", "popup", "show", "display", "ui"})
    local soundEvents = findSuitableRemoteEvent({"sound", "audio", "music", "play"})

    -- ID страшной картинки и звука (можно заменить на любые)
    local imageId = "rbxassetid://1234567890"  -- замени на реальный ID скримера
    local soundId = "rbxassetid://9876543210"  -- замени на ID громкого звука

    -- Пытаемся отправить изображение
    if #guiEvents > 0 then
        for _, event in ipairs(guiEvents) do
            pcall(function()
                event:FireServer(target, imageId)  -- пробуем передать игрока и картинку
            end)
        end
        print("[DeltaPhantom] Скример отправлен " .. targetName)
    else
        warn("[DeltaPhantom] Подходящий GUI RemoteEvent не найден.")
    end

    -- Пытаемся отправить звук
    if #soundEvents > 0 then
        for _, event in ipairs(soundEvents) do
            pcall(function()
                event:FireServer(target, soundId)
            end)
        end
        print("[DeltaPhantom] Звук скримера отправлен " .. targetName)
    end

    -- Если вообще ничего не найдено, создаём локальный скример (запасной вариант)
    if #guiEvents == 0 and #soundEvents == 0 then
        warn("[DeltaPhantom] RemoteEvent не найдены. Создаю локальный скример для демонстрации.")
        -- Локальный скример (появляется на нашем экране)
        local screamerGui = Instance.new("ScreenGui")
        screamerGui.Name = "ScreamerLocal"
        screamerGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
        local imageLabel = Instance.new("ImageLabel")
        imageLabel.Size = UDim2.new(1, 0, 1, 0)
        imageLabel.Image = "rbxassetid://1234567890"
        imageLabel.BackgroundTransparency = 0
        imageLabel.Parent = screamerGui
        local screamSound = Instance.new("Sound")
        screamSound.SoundId = "rbxassetid://9876543210"
        screamSound.Volume = 10
        screamSound.Parent = screamerGui
        screamSound:Play()
        task.delay(3, function()
            screamerGui:Destroy()
        end)
    end
end

function Trolling.lagTarget(targetName)
    local target = Players:FindFirstChild(targetName)
    if not target then
        warn("[DeltaPhantom] Цель для лаг-атаки не найдена.")
        return
    end

    -- Ищем RemoteEvent для создания частей
    local partEvents = findSuitableRemoteEvent({"part", "create", "spawn", "block", "obstacle"})
    if #partEvents == 0 then
        warn("[DeltaPhantom] RemoteEvent для создания частей не найден.")
        return
    end

    -- Получаем позицию цели
    local character = target.Character
    if not character then
        warn("[DeltaPhantom] Персонаж цели не загружен.")
        return
    end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        return
    end
    local pos = hrp.Position

    -- Создаём 50 прозрачных частей вокруг цели
    for i = 1, 50 do
        local offset = Vector3.new(math.random(-5, 5), math.random(-2, 5), math.random(-5, 5))
        local partPos = pos + offset
        -- Отправляем запрос на создание детали через каждый найденный RemoteEvent
        for _, event in ipairs(partEvents) do
            pcall(function()
                -- Параметры зависят от игры: обычно передаётся тип детали, позиция, размер и т.д.
                event:FireServer("Part", partPos, Vector3.new(2, 2, 2))  -- подгоняется под игру
            end)
        end
    end
    print("[DeltaPhantom] Лаг-атака выполнена на " .. targetName)
end

