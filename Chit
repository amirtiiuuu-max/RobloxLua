                btn.Name = tab_name
                btn.Parent = tab_bar
                btn.MouseButton1Click:Connect(function() switch_tab(tab_name) end)
                tab_buttons[tab_name] = btn
                
                -- Наполнение панелей
                if tab_name == "VISUALS" then
                    local y = 10
                    -- Wallhack
                    local wh_btn = create_state_button(panel, "Wallhack (сквозь стены)", false, function(state)
                        if state then
                            Wallhack:enable()
                        else
                            Wallhack:disable()
                        end
                    end)
                    wh_btn.Position = UDim2.new(0,10,0,y)
                    y = y + 55
                    
                    -- Time Controller с ползунком
                    local time_btn = create_state_button(panel, "Фиксация времени суток", false, function(state)
                        if state then
                            TimeController:enable(14)
                        else
                            TimeController:disable()
                        end
                    end)
                    time_btn.Position = UDim2.new(0,10,0,y)
                    y = y + 55
                    
                    -- Слайдер для выбора времени (если активно)
                    local time_slider = create_slider(panel, "Время (0-24)", 0, 24, 14, function(val)
                        if TimeController.active then
                            TimeController:set_time(val)
                        end
                    end)
                    time_slider.Position = UDim2.new(0,10,0,y)
                    y = y + 70
                    
                elseif tab_name == "UTILS" then
                    local y = 10
                    -- AutoFarm
                    local af_btn = create_state_button(panel, "AutoFarm (сбор предметов)", false, function(state)
                        if state then
                            AutoFarm:enable(Ghost.AutoFarmRange)
                        else
                            AutoFarm:disable()
                        end
                    end)
                    af_btn.Position = UDim2.new(0,10,0,y)
                    y = y + 55
                    
                    -- Слайдер радиуса автофарма
                    local range_slider = create_slider(panel, "Радиус AutoFarm", 10, 150, Ghost.AutoFarmRange, function(val)
                        Ghost.AutoFarmRange = val
                        if AutoFarm.active then
                            AutoFarm:disable()
                            AutoFarm:enable(val)
                        end
                    end)
                    range_slider.Position = UDim2.new(0,10,0,y)
                    y = y + 70
                    
                    -- AntiKick
                    local ak_btn = create_state_button(panel, "AntiKick + Блок репортов", false, function(state)
                        if state then
                            AntiKick:enable()
                        else
                            AntiKick:disable()
                        end
                    end)
                    ak_btn.Position = UDim2.new(0,10,0,y)
                    y = y + 55
                    
                    -- Автоклик
                    local ac_btn = create_state_button(panel, "Автоклик (каждые 0.1с)", false, function(state)
                        if state then
                            MacroSystem:start_autoclick(Ghost.MacroDelay)
                        else
                            MacroSystem:stop_autoclick()
                        end
                    end)
                    ac_btn.Position = UDim2.new(0,10,0,y)
                    y = y + 55
                    
                    -- Слайдер задержки автоклика
                    local delay_slider = create_slider(panel, "Задержка автоклика (сек)", 0.05, 2, Ghost.MacroDelay, function(val)
                        Ghost.MacroDelay = val
                        if MacroSystem.autoclick_active then
                            MacroSystem:stop_autoclick()
                            MacroSystem:start_autoclick(val)
                        end
                    end)
                    delay_slider.Position = UDim2.new(0,10,0,y)
                    y = y + 70
                    
                    -- Кнопка сохранения настроек
                    local save_btn = Instance.new("TextButton")
                    save_btn.Size = UDim2.new(1, -20, 0, 44)
                    save_btn.Position = UDim2.new(0,10,0,y)
                    save_btn.BackgroundColor3 = Color3.fromRGB(70,90,70)
                    save_btn.Text = "💾 Сохранить настройки"
                    save_btn.TextColor3 = Color3.new(1,1,1)
                    save_btn.Font = Enum.Font.GothamSemibold
                    save_btn.TextSize = 14
                    save_btn.Parent = panel
                    save_btn.MouseButton1Click:Connect(function()
                        save_settings()
                        print("[Ghost] Настройки сохранены в файл.")
                    end)
                    local corner_save = Instance.new("UICorner")
                    corner_save.CornerRadius = UDim.new(0, 8)
                    corner_save.Parent = save_btn
                end
            end
        end
    end
end

-- Загрузка сохранённых настроек при старте
load_settings()

