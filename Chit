local invisOriginalCFrame = nil
local invisConnections = {}   -- для дополнительных слушателей

-- ===================== УТИЛИТЫ =====================
local function safeFind(instance, name)
    local success, result = pcall(function()
        return instance:FindFirstChild(name)
    end)
    return success and result or nil
end

local function deepHide(instance)
    if instance:IsA("GuiObject") then
        instance.Visible = false
    end
    for _, child in ipairs(instance:GetChildren()) do
        deepHide(child)
    end
end

local function tweenPos(guiObject, targetPosition, duration, callback)
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(guiObject, tweenInfo, {Position = targetPosition})
    tween:Play()
    if callback then
        tween.Completed:Connect(function()
            callback()
        end)
    end
    table.insert(tweenObjects, tween)
    return tween
end

-- ===================== НЕВИДИМОСТЬ (КЛОН) =====================
local Invisibility = {}

function Invisibility.enable()
    if invisEnabled then return end
    local character = LocalPlayer.Character
    if not character then
        local conn
        conn = LocalPlayer.CharacterAdded:Connect(function(char)
            conn:Disconnect()
            Invisibility.enable()
        end)
        return
    end

    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- 1. Сохраняем позицию и делаем персонажа невидимым/бесколлизионным
    invisOriginalCFrame = hrp.CFrame
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Transparency = 1
            part.CanCollide = false
        elseif part:IsA("BillboardGui") then
            part.Enabled = false
        end
    end

    -- 2. Перемещаем персонажа глубоко под карту
    local voidPos = Vector3.new(invisOriginalCFrame.Position.X, -500, invisOriginalCFrame.Position.Z)
    hrp.CFrame = CFrame.new(voidPos)

    -- 3. Создаём локального клона на старом месте
    invisClone = character:Clone()
    invisClone.Name = "PhantomClone"
    invisClone.Archivable = false
    -- Очищаем клона от лишнего (звуки, скрипты, анимации)
    for _, obj in ipairs(invisClone:GetDescendants()) do
        if obj:IsA("Sound") or obj:IsA("Script") or obj:IsA("LocalScript") then
            obj:Destroy()
        end
    end
    -- Устанавливаем прозрачность клона (видим только мы)
    for _, part in ipairs(invisClone:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Transparency = 0.6    -- полупрозрачный, чтобы ты видел себя
            part.CanCollide = false
        elseif part:IsA("BillboardGui") then
            part.Enabled = false
        end
    end
    invisClone.Parent = Workspace

    -- 4. Синхронизация: привязываем камеру к клону и обновляем его позицию каждый кадр
    workspace.CurrentCamera.CameraSubject = invisClone:FindFirstChild("Humanoid")
    workspace.CurrentCamera.CameraType = Enum.CameraType.Custom

    local realHRP = hrp
    local cloneHRP = invisClone:FindFirstChild("HumanoidRootPart")
    if cloneHRP then
        cloneHRP.CFrame = invisOriginalCFrame
    end

    local lastCFrame = realHRP.CFrame
    invisConnection = RunService.RenderStepped:Connect(function()
        if not invisEnabled or not character or not character:FindFirstChild("HumanoidRootPart") then
            invisConnection:Disconnect()
            return
        end
        realHRP = character.HumanoidRootPart
        -- Вычисляем дельту, на которую сместился реальный персонаж (в бездне)
        local delta = realHRP.CFrame:ToObjectSpace(lastCFrame)
        lastCFrame = realHRP.CFrame

        if cloneHRP and cloneHRP.Parent then
            cloneHRP.CFrame = cloneHRP.CFrame * delta
        end
    end)

    -- 5. Скрываем UI (лидерборд, меню)
    local playerList = safeFind(CoreGui:FindFirstChild("RobloxGui"), "PlayerList")
    if playerList then playerList.Enabled = false end
    local pauseMenu = safeFind(CoreGui:FindFirstChild("RobloxGui"), "PauseMenu")
    if pauseMenu then deepHide(pauseMenu) end
    local topBar = safeFind(CoreGui:FindFirstChild("RobloxGui"), "TopBar")
    if topBar then topBar.Visible = false end

    -- Блокируем появление новых надписей на реальном персонаже
    local descConn = character.DescendantAdded:Connect(function(child)
        if child:IsA("BillboardGui") then
            child.Enabled = false
        end
    end)
    table.insert(invisConnections, descConn)

    invisEnabled = true
    print("[DeltaPhantom v4.0] Ты невидим для всех. Управляй клоном!")
end

function Invisibility.disable()
    if not invisEnabled then return end
    invisEnabled = false

    -- Отключаем синхронизацию
    if invisConnection then
        invisConnection:Disconnect()
        invisConnection = nil
    end
    -- Отключаем дополнительные слушатели
    for _, conn in ipairs(invisConnections) do
        conn:Disconnect()
    end
    invisConnections = {}

    -- Удаляем клона
    if invisClone then
        invisClone:Destroy()
        invisClone = nil
    end

    -- Возвращаем настоящего персонажа на место клона
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        local hrp = character.HumanoidRootPart
        if invisOriginalCFrame then
            hrp.CFrame = invisOriginalCFrame
        else
            -- На случай ошибки поднимаем из бездны
            hrp.CFrame = hrp.CFrame + Vector3.new(0, 500, 0)
        end
        -- Восстанавливаем коллизии и прозрачность
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Transparency = 0
                part.CanCollide = true
            elseif part:IsA("BillboardGui") then
                part.Enabled = true
            end
        end
        -- Возвращаем камеру
        workspace.CurrentCamera.CameraSubject = character:FindFirstChild("Humanoid")
        workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
    end

    -- Восстанавливаем UI
    local playerList = safeFind(CoreGui:FindFirstChild("RobloxGui"), "PlayerList")
    if playerList then playerList.Enabled = true end
    local pauseMenu = safeFind(CoreGui:FindFirstChild("RobloxGui"), "PauseMenu")
    if pauseMenu then pauseMenu.Visible = true end
    local topBar = safeFind(CoreGui:FindFirstChild("RobloxGui"), "TopBar")
    if topBar then topBar.Visible = true end

    invisOriginalCFrame = nil
    print("[DeltaPhantom v4.0] Невидимость отключена. Ты снова видим.")
end

-- ===================== СЛЕЖЕНИЕ (БЕЗ ИЗМЕНЕНИЙ) =====================
local Tracking = {}
Tracking.currentConnection = nil
Tracking.mouseWheelConnection = nil

function Tracking.enable(targetPlayerName)
    if watchEnabled then
        watchTarget = Players:FindFirstChild(targetPlayerName)
        if not watchTarget then
            warn("[DeltaPhantom] Игрок " .. targetPlayerName .. " не найден.")
            return
        end
        print("[DeltaPhantom] Цель слежения изменена на " .. watchTarget.Name)
        return
    end

    local target = Players:FindFirstChild(targetPlayerName)
    if not target then
        warn("[DeltaPhantom] Игрок не найден, слежение не запущено.")
        return
    end

    watchTarget = target
    watchEnabled = true

    local camera = workspace.CurrentCamera
    camera.CameraType = Enum.CameraType.Scriptable

    Tracking.currentConnection = RunService.RenderStepped:Connect(function(deltaTime)
        if not watchEnabled or not watchTarget then return end

        local character = watchTarget.Character
        if not character then return end

        local head = character:FindFirstChild("Head")
        local humanoidRoot = character:FindFirstChild("HumanoidRootPart")
        if not head or not humanoidRoot then return end

        local desiredCFrame
        if watchMode == "First" then
            desiredCFrame = head.CFrame * CFrame.new(0, 0.1, 0)
        elseif watchMode == "Second" then
            local behind = head.CFrame * CFrame.new(0, 0, 5)
            desiredCFrame = CFrame.lookAt(behind.Position, head.Position)
        elseif watchMode == "Third" then
            local offset = (head.CFrame.LookVector * -zoomDistance) + Vector3.new(0, 3, 0)
            local camPos = head.Position + offset
            desiredCFrame = CFrame.lookAt(camPos, head.Position)
        elseif watchMode == "Far" then
            local offset = (head.CFrame.LookVector * -zoomDistance) + Vector3.new(0, 4, 0)
            local camPos = head.Position + offset
            desiredCFrame = CFrame.lookAt(camPos, head.Position)
        end

        local currentCFrame = camera.CFrame
        local smoothCFrame = currentCFrame:Lerp(desiredCFrame, 0.2)
        camera.CFrame = smoothCFrame
    end)

    Tracking.mouseWheelConnection = UserInputService.InputChanged:Connect(function(input)
        if not watchEnabled then return end
        if input.UserInputType == Enum.UserInputType.MouseWheel then
            if watchMode == "Third" or watchMode == "Far" then
                zoomDistance = zoomDistance - input.Position.Z * 0.1
                zoomDistance = math.clamp(zoomDistance, 1, 100)
            end
        end
    end)

    print("[DeltaPhantom] Слежение за " .. watchTarget.Name .. " активировано. Режим: " .. watchMode)
end

function Tracking.disable()
    if not watchEnabled then return end
    watchEnabled = false

    if Tracking.currentConnection then
        Tracking.currentConnection:Disconnect()
        Tracking.currentConnection = nil
    end
    if Tracking.mouseWheelConnection then
        Tracking.mouseWheelConnection:Disconnect()
        Tracking.mouseWheelConnection = nil
    end

    local camera = workspace.CurrentCamera
    camera.CameraType = Enum.CameraType.Custom
    camera.CameraSubject = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")

    watchTarget = nil
    print("[DeltaPhantom] Слежение отключено.")
end

function Tracking.setMode(mode)
    if mode == "First" or mode == "Second" or mode == "Third" or mode == "Far" then
        watchMode = mode
        if mode == "First" or mode == "Second" then
            zoomDistance = 5
        elseif mode == "Third" then
            zoomDistance = 10
        elseif mode == "Far" then
            zoomDistance = 5
        end
        print("[DeltaPhantom] Режим слежения изменён на " .. mode)
    end
end

-- ===================== ТЕЛЕПОРТ (С УЧЁТОМ КЛОНА) =====================
local function teleportToPlayer(targetName)
    local target = Players:FindFirstChild(targetName)
    if not target then
        warn("[DeltaPhantom] Игрок не найден для телепорта.")
        return
    end

    local targetCharacter = target.Character
    if not targetCharacter or not targetCharacter:FindFirstChild("HumanoidRootPart") then
        warn("[DeltaPhantom] Персонаж цели не загружен.")
        return
    end

    local localCharacter = LocalPlayer.Character
    if not localCharacter or not localCharacter:FindFirstChild("HumanoidRootPart") then
        warn("[DeltaPhantom] Ваш персонаж не загружен.")
        return
    end

    local targetPos = targetCharacter.HumanoidRootPart.CFrame * CFrame.new(0, 3, 0)
    local realHRP = localCharacter.HumanoidRootPart

    -- Перемещаем реального персонажа в бездне на нужное место (если невидимость активна)
    if invisEnabled and invisClone and invisClone:FindFirstChild("HumanoidRootPart") then
        -- Перемещаем реального персонажа под землю, но так, чтобы он оставался под клоном
        local newVoidPos = targetPos.Position - Vector3.new(0, 500, 0)  -- цель под землёй
        realHRP.CFrame = CFrame.new(newVoidPos)
        -- Телепортируем клона наверх
        invisClone.HumanoidRootPart.CFrame = targetPos
        -- Обновляем сохранённую позицию (для отключения невидимости вернёмся сюда)
        invisOriginalCFrame = targetPos
    else
        -- Обычный телепорт
        realHRP.CFrame = targetPos
    end
    print("[DeltaPhantom] Телепортирован к " .. targetName)
end

-- ===================== ТРОЛЛИНГ (СОХРАНЁН ИЗ v3.1) =====================
local Trolling = {}

local function findRemoteEvents(keywords)
    local found = {}
    local function scan(parent)
        for _, obj in ipairs(parent:GetChildren()) do
            if obj:IsA("RemoteEvent") then
                local name = obj.Name:lower()
                for _, kw in ipairs(keywords) do
                    if name:find(kw) then
                        table.insert(found, obj)
                        break
                    end
                end
            end
            if obj:IsA("Folder") or obj:IsA("Model") or obj:IsA("Tool") then
                scan(obj)
            end
        end
    end
    scan(ReplicatedStorage)
    if #found == 0 then
        scan(Workspace)
    end
    for _, player in ipairs(Players:GetPlayers()) do
        local playerGui = player:FindFirstChild("PlayerGui")
        if playerGui then
            scan(playerGui)
        end
    end
    return found
end

function Trolling.screamer(targetName)
    local target = Players:FindFirstChild(targetName)
    if not target then
        warn("[DeltaPhantom] Цель для скримера не найдена.")
        return
    end

    local guiEvents = findRemoteEvents({"gui", "notification", "popup", "show", "display", "ui", "message"})
    local soundEvents = findRemoteEvents({"sound", "audio", "music", "play"})

    local imageId = "rbxassetid://1234567890"
    local soundId = "rbxassetid://9876543210"

    local success = false
    if #guiEvents > 0 then
        for _, event in ipairs(guiEvents) do
            pcall(function()
                event:FireServer(target, imageId)
            end)
        end
        success = true
    end
    if #soundEvents > 0 then
        for _, event in ipairs(soundEvents) do
            pcall(function()
                event:FireServer(target, soundId)
            end)
        end
        success = true
    end

    if not success then
        warn("[DeltaPhantom] RemoteEvent не найдены, показываю локальный скример.")
        local screamerGui = Instance.new("ScreenGui")
        screamerGui.Name = "ScreamerLocal"
        screamerGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
        local imageLabel = Instance.new("ImageLabel")
        imageLabel.Size = UDim2.new(1, 0, 1, 0)
        imageLabel.Image = imageId
        imageLabel.BackgroundTransparency = 0
        imageLabel.Parent = screamerGui
        local screamSound = Instance.new("Sound")
        screamSound.SoundId = soundId
        screamSound.Volume = 10
        screamSound.Parent = screamerGui
        screamSound:Play()
        task.delay(3, function()
            screamerGui:Destroy()
        end)
    else
        print("[DeltaPhantom] Скример отправлен " .. targetName .. " через RemoteEvent.")
    end
end

function Trolling.lagTarget(targetName)
    local target = Players:FindFirstChild(targetName)
    if not target then
        warn("[DeltaPhantom] Цель для лаг-атаки не найдена.")
        return
    end

    local partEvents = findRemoteEvents({"part", "create", "spawn", "block", "obstacle", "build"})
    if #partEvents > 0 then
        local targetChar = target.Character
        if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
            local pos = targetChar.HumanoidRootPart.Position
            for i = 1, 30 do
                local offset = Vector3.new(math.random(-3, 3), math.random(-2, 2), math.random(-3, 3))
                for _, event in ipairs(partEvents) do
                    pcall(function()
                        event:FireServer(pos + offset, Vector3.new(2, 2, 2))
                    end)
                end
                task.wait(0.01)
            end
            print("[DeltaPhantom] Лаг-атака выполнена на " .. targetName .. " через RemoteEvent.")
        end
    else
        warn("[DeltaPhantom] RemoteEvent не найдены, создаю локальный спам частей.")
        local dummy = Instance.new("Model")
        dummy.Name = "LagPartsDemo"
        dummy.Parent = Workspace
        for i = 1, 100 do
            local part = Instance.new("Part")
            part.Size = Vector3.new(2, 2, 2)
            part.Anchored = true
            part.Transparency = 0.8
            part.CanCollide = false
            part.Position = Vector3.new(math.random(-10, 10), math.random(0, 10), math.random(-10, 10))
            part.Parent = dummy
        end
        task.delay(5, function()
            dummy:Destroy()
        end)
    end
end

