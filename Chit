-- 8.16 ESP богатых игроков
function Zeus.enablePlayerWealthESP()
    for _, player in pairs(players:GetPlayers()) do
        if player ~= localPlayer then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local bill = Instance.new("BillboardGui")
                bill.Size = UDim2.new(0, 4, 0, 2)
                bill.AlwaysOnTop = true
                bill.Parent = char.HumanoidRootPart
                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(1,0,1,0)
                label.BackgroundTransparency = 1
                label.Text = "???"
                label.TextScaled = true
                label.Parent = bill
                -- Обновляем сумму
                spawn(function()
                    while bill.Parent do
                        local wealth = Zeus.getPlayerWealth(player)
                        label.Text = "💰 " .. tostring(wealth)
                        task.wait(1)
                    end
                end)
            end
        end
    end
end

function Zeus.getPlayerWealth(player)
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        for _, v in pairs(ls:GetChildren()) do
            if v:IsA("NumberValue") then
                return v.Value
            end
        end
    end
    return 0
end

function Zeus.teleportToRichestPlayer()
    local richest = nil
    local maxMoney = -1
    for _, player in pairs(players:GetPlayers()) do
        if player ~= localPlayer then
            local wealth = Zeus.getPlayerWealth(player)
            if wealth > maxMoney then
                maxMoney = wealth
                richest = player
            end
        end
    end
    if richest and richest.Character then
        localPlayer.Character.HumanoidRootPart.CFrame = richest.Character.HumanoidRootPart.CFrame
    end
end

