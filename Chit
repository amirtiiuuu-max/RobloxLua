-- ФУНКЦИЯ 3: TELEPORT (ТЕЛЕПОРТАЦИЯ)
-- █████████████████████████████████████████████████████████████████████████████████████████████████████

local Teleport = {}

function Teleport:to_player(target_player)
    if not target_player or not target_player.Character then
        warn("[Teleport] Цель не имеет персонажа")
        return false
    end
    local char = LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    local target_root = target_player.Character:FindFirstChild("HumanoidRootPart")
    if root and target_root then
        root.CFrame = target_root.CFrame + Vector3.new(0, 2, 0)
        -- Для плавности добавим небольшую задержку после телепорта
        task.wait()
        root.Velocity = Vector3.new(0,0,0)
        return true
    end
    return false
end

function Teleport:to_coords(x, y, z)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        root.CFrame = CFrame.new(x, y, z)
        task.wait()
        root.Velocity = Vector3.new(0,0,0)
    end
end

function Teleport:to_random_player()
    local players = {}
    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character then
            table.insert(players, v)
        end
    end
    if #players > 0 then
        self:to_player(players[math.random(1, #players)])
    else
        warn("[Teleport] Нет доступных игроков")
    end
end

