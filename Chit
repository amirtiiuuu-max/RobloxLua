        teleportToPlayer(Gui.selectedPlayer.Name)
    end)

    -- Кнопка скрытия/показа меню (маленькая иконка в углу)
    local toggleButton = Instance.new("TextButton")
    toggleButton.Size = UDim2.new(0, 30, 0, 30)
    toggleButton.Position = UDim2.new(0, mainFrame.Size.X.Offset - 30, 0, 5)
    toggleButton.Text = "−"
    toggleButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleButton.Font = Enum.Font.GothamBold
    toggleButton.TextSize = 20
    local toggleCorner = Instance.new("UICorner")
    toggleCorner.CornerRadius = UDim.new(0, 4)
    toggleCorner.Parent = toggleButton
    toggleButton.Parent = mainFrame

    local mainFrameVisible = true
    local originalSize = mainFrame.Size
    local collapsedSize = UDim2.new(0, 30, 0, 30)
    toggleButton.MouseButton1Click:Connect(function()
        if mainFrameVisible then
            -- Свернуть меню в иконку
            mainFrame:TweenSize(collapsedSize, "Out", "Quad", 0.3, true)
            for _, child in ipairs(mainFrame:GetChildren()) do
                if child ~= toggleButton and child ~= shadowFrame and child ~= toggleCorner and child.Name ~= "UICorner" then
                    pcall(function() child.Visible = false end)
                end
            end
            toggleButton.Text = "+"
            mainFrameVisible = false
        else
            -- Развернуть
            mainFrame:TweenSize(originalSize, "Out", "Quad", 0.3, true)
            for _, child in ipairs(mainFrame:GetChildren()) do
                pcall(function() child.Visible = true end)
            end
            toggleButton.Text = "−"
            mainFrameVisible = true
        end
    end)

    -- Анимация появления меню
    mainFrame.Position = UDim2.new(0, -300, 0.5, -200)   -- начальная позиция за экраном слева
    tweenPos(mainFrame, UDim2.new(0, 10, 0.5, -200), 0.5, function()
        print("[DeltaPhantom] Меню готово.")
    end)

    -- Сохраняем ссылки для возможной доработки
    Gui.screenGui = screenGui
    Gui.mainFrame = mainFrame
    Gui.invisButton = invisButton
    Gui.watchToggle = watchToggle
    Gui.playerDropdown = playerDropdown
end

