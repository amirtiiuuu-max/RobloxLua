-- ФУНКЦИЯ 6: WALLHACK (ПРОСВЕЧИВАНИЕ ИГРОКОВ И ПРЕДМЕТОВ)
-- █████████████████████████████████████████████████████████████████████████████████████████████████████

local Wallhack = {
    active = false,
    original_materials = {},
    original_transparency = {}
}

function Wallhack:enable()
    if self.active then return end
    self.active = true
    -- Делаем все стены и полы полупрозрачными (только локально)
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Material ~= Enum.Material.Neon then
            if not self.original_materials[obj] then
                self.original_materials[obj] = obj.Material
                self.original_transparency[obj] = obj.Transparency
            end
            if obj.Material == Enum.Material.Concrete or obj.Material == Enum.Material.Brick then
                obj.LocalTransparencyModifier = 0.6
            else
                obj.LocalTransparencyModifier = 0.3
            end
        end
    end
    -- Дополнительно: рисуем контуры игроков (через Highlight)
    Players.PlayerAdded:Connect(function(plr)
        if self.active then
            plr.CharacterAdded:Connect(function(char)
                task.wait(0.5)
                self:add_highlight(char)
            end)
        end
    end)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            self:add_highlight(plr.Character)
        end
    end
    print("[Wallhack] Включён (стены полупрозрачны, игроки подсвечены).")
end

function Wallhack:add_highlight(char)
    local highlight = Instance.new("Highlight")
    highlight.Name = "GhostWallhack"
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.FillTransparency = 0.7
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0.3
    highlight.Parent = char
    -- Автоудаление при смерти
    char.AncestryChanged:Connect(function()
        if not char.Parent then highlight:Destroy() end
    end)
end

function Wallhack:disable()
    if not self.active then return end
    self.active = false
    for obj, mat in pairs(self.original_materials) do
        if obj and obj.Parent then
            obj.LocalTransparencyModifier = 0
        end
    end
    for _, highlight in pairs(Workspace:GetDescendants()) do
        if highlight:IsA("Highlight") and highlight.Name == "GhostWallhack" then
            highlight:Destroy()
        end
    end
    self.original_materials = {}
    self.original_transparency = {}
    print("[Wallhack] Выключен.")
end

