-- ФУНКЦИЯ 2: SPECTATE (КАМЕРА ДРУГОГО ИГРОКА)
-- █████████████████████████████████████████████████████████████████████████████████████████████████████

local Spectate = {
    active = false,
    target = nil,
    connection = nil,
    original_cam_type = nil,
    original_cam_subject = nil,
    offset = Vector3.new(0, 2.5, 0)  -- небольшая высота
}

function Spectate:get_player_list()
    local list = {}
    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= LocalPlayer then
            table.insert(list, v)
        end
    end
    return list
end

function Spectate:set_target(player)
    if not player or not player.Character then
        warn("[Spectate] Цель не имеет персонажа")
        return false
    end
    self.target = player
    local cam = workspace.CurrentCamera
    self.original_cam_type = cam.CameraType
    self.original_cam_subject = cam.CameraSubject
    cam.CameraType = Enum.CameraType.Scriptable
    -- Обновление позиции камеры каждый кадр
    if self.connection then self.connection:Disconnect() end
    self.connection = RunService.RenderStepped:Connect(function()
        if not self.active or not self.target or not self.target.Character then
            if self.active then self:disable() end
            return
        end
        local root = self.target.Character:FindFirstChild("HumanoidRootPart")
        if root then
            cam.CFrame = root.CFrame + self.offset
        end
    end)
    return true
end

function Spectate:enable(target_player)
    if self.active then return end
    local target = target_player
    if not target then
        local players = self:get_player_list()
        if #players == 0 then
            warn("[Spectate] Нет других игроков для наблюдения")
            return
        end
        target = players[1]
    end
    if self:set_target(target) then
        self.active = true
        print("[Spectate] Наблюдение за " .. target.Name)
    end
end

function Spectate:disable()
    if not self.active then return end
    self.active = false
    if self.connection then
        self.connection:Disconnect()
        self.connection = nil
    end
    local cam = workspace.CurrentCamera
    cam.CameraType = self.original_cam_type or Enum.CameraType.Custom
    cam.CameraSubject = self.original_cam_subject or LocalPlayer.Character
    self.target = nil
    print("[Spectate] Наблюдение выключено")
end

function Spectate:next_target()
    if not self.active then
        warn("[Spectate] Сначала включите камеру")
        return
    end
    local players = self:get_player_list()
    if #players == 0 then
        self:disable()
        return
    end
    local idx = 1
    if self.target then
        for i, p in ipairs(players) do
            if p == self.target then
                idx = i + 1
                break
            end
        end
    end
    if idx > #players then idx = 1 end
    self:set_target(players[idx])
    print("[Spectate] Теперь наблюдение за " .. self.target.Name)
end

