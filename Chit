LocalPlayer.CharacterAdded:Connect(function(character)
    if invisEnabled then
        -- Отключаем старый слушатель (на всякий случай)
        if invisDescendantConn then
            invisDescendantConn:Disconnect()
        end
        Invisibility.applyToCharacter(character)
        -- Подключаем новый слушатель на нового персонажа
        invisDescendantConn = character.DescendantAdded:Connect(function(descendant)
            if descendant:IsA("BillboardGui") then
                descendant.Enabled = false
            end
        end)
    end
end)

