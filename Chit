local ChatSpy={active=false,conns={},oldFire=nil}
function ChatSpy:enable()if self.active then return end self.active=true local rep=ReplicatedStorage local remote=rep:FindFirstChild("DefaultChatSystemChatEvents")or rep:FindFirstChild("SayMessageRequest")or rep:FindFirstChild("Chatted")if remote and remote:IsA("RemoteEvent")then self.oldFire=remote.FireServer remote.FireServer=function(...)local args={...}if #args>=1 and type(args[1])=="string"then print("[CHAT SENT] "..LocalPlayer.Name..": "..args[1])end return self.oldFire(...)end end local onMsg=rep:FindFirstChild("OnChatMessage")if onMsg and onMsg:IsA("RemoteEvent")then table.insert(self.conns,onMsg.OnClientEvent:Connect(function(pl,msg)if self.active and pl~=LocalPlayer then print("[CHAT] "..pl.Name..": "..msg)end end))end local txt=game:GetService("TextChatService")if txt then for _,ch in pairs(txt.TextChannels:GetChildren())do table.insert(self.conns,ch.OnMessageReceived:Connect(function(m)if self.active and m.FromSpeaker~=LocalPlayer then print("[CHAT] "..m.FromSpeaker.Name..": "..m.Text)end end))end end print("[ChatSpy] Включён. Все сообщения в консоль (F9).")end
function ChatSpy:disable()if not self.active then return end self.active=false for _,c in ipairs(self.conns)do c:Disconnect()end self.conns={}if self.oldFire and self.remote then self.remote.FireServer=self.oldFire end print("[ChatSpy] Выключен.")end
local Spectate={active=false,target=nil,conn=nil,origCamType=nil,origCamSubj=nil,viewMode=2,modes={{name="1-е лицо",offset=Vector3.new(0,1.5,0)},{name="3-е лицо",offset=Vector3.new(0,2.5,4)},{name="Дальний вид",offset=Vector3.new(0,5,12)}}}
function Spectate:getPlayers()local list={}for _,v in ipairs(Players:GetPlayers())do if v~=LocalPlayer then table.insert(list,v)end end return list end
function Spectate:setTarget(pl)if not pl or not pl.Character then return false end self.target=pl local cam=workspace.CurrentCamera self.origCamType=cam.CameraType self.origCamSubj=cam.CameraSubject cam.CameraType=Enum.CameraType.Scriptable if self.conn then self.conn:Disconnect()end self.conn=RunService.RenderStepped:Connect(function()if not self.active or not self.target or not self.target.Character then if self.active then self:disable()end return end local root=self.target.Character:FindFirstChild("HumanoidRootPart")if root then local off=self.modes[self.viewMode].offset if self.viewMode==1 then local head=self.target.Character:FindFirstChild("Head")if head then cam.CFrame=head.CFrame+off else cam.CFrame=root.CFrame+off end else cam.CFrame=root.CFrame+off end end end)return true end
function Spectate:enable(pl)if self.active then return end local target=pl if not target then local players=self:getPlayers()if #players==0 then warn("Нет других игроков для наблюдения")return end target=players[1]end if self:setTarget(target)then self.active=true print("[Spectate] Наблюдение за "..target.Name..", вид: "..self.modes[self.viewMode].name)end end
function Spectate:disable()if not self.active then return end self.active=false if self.conn then self.conn:Disconnect()self.conn=nil end local cam=workspace.CurrentCamera cam.CameraType=self.origCamType or Enum.CameraType.Custom cam.CameraSubject=self.origCamSubj or LocalPlayer.Character self.target=nil print("[Spectate] Наблюдение выключено")end
function Spectate:nextPlayer()if not self.active then warn("Сначала включи камеру")return end local players=self:getPlayers()if #players==0 then self:disable()return end local idx=1 for i,p in ipairs(players)do if p==self.target then idx=i+1 break end end if idx>#players then idx=1 end self:setTarget(players[idx])print("[Spectate] Теперь наблюдение за "..self.target.Name)end
function Spectate:cycleView()if not self.active then warn("Сначала включи камеру")return end self.viewMode=self.viewMode%#self.modes+1 print("[Spectate] Вид сменён на: "..self.modes[self.viewMode].name)end
