local Shadow = {
    active = false,
    originalParts = {},
    originalSpeed = nil,
    originalJump = nil,
    originalTools = {},
    originalAccessories = {},
    originalClothes = {},
    originalBillboards = {},
    originalDesc = nil,
    oldPlayerIndex = nil,
    charConn = nil
}

function Shadow:saveOriginal(char)
    self.originalParts = {}
    self.originalTools = {}
    self.originalAccessories = {}
    self.originalClothes = {}
    self.originalBillboards = {}
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        self.originalSpeed = hum.WalkSpeed
        self.originalJump = hum.JumpPower
    end
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            self.originalParts[part] = {
                Transparency = part.Transparency,
                CanCollide = part.CanCollide,
                CanTouch = part.CanTouch,
                CanQuery = part.CanQuery,
                Color = part.Color,
                Material = part.Material,
                Reflectance = part.Reflectance
            }
        elseif part:IsA("Decal") or part:IsA("Texture") then
            self.originalParts[part] = { Transparency = part.Transparency }
        elseif part:IsA("Sound") then
            self.originalParts[part] = { Volume = part.Volume, Playing = part.Playing }
        end
    end
    local head = char:FindFirstChild("Head")
    if head then
        for _, g in pairs(head:GetChildren()) do
            if g:IsA("BillboardGui") then
                self.originalBillboards[g] = g.Enabled
            end
        end
    end
    for _, child in pairs(char:GetChildren()) do
        if child:IsA("Tool") then
            table.insert(self.originalTools, child)
        elseif child:IsA("Accessory") then
            table.insert(self.originalAccessories, child)
        elseif child:IsA("Clothing") then
            table.insert(self.originalClothes, child)
        end
    end
    local desc = char:FindFirstChild("HumanoidDescription")
    if desc then
        self.originalDesc = desc:Clone()
    end
end

function Shadow:applyGhost(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = 16
        hum.JumpPower = 50
        hum.AutoRotate = true
        for _, track in pairs(hum:GetPlayingAnimationTracks()) do
            track:Stop()
        end
    end
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Transparency = 1
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false
            part.Color = Color3.new(0, 0, 0)
            part.Material = Enum.Material.SmoothPlastic
            part.Reflectance = 0
        elseif part:IsA("Decal") or part:IsA("Texture") then
            part.Transparency = 1
        elseif part:IsA("Sound") then
            part.Volume = 0
            part.Playing = false
        end
    end
    local head = char:FindFirstChild("Head")
    if head then
        for _, g in pairs(head:GetChildren()) do
            if g:IsA("BillboardGui") then
                g.Enabled = false
            end
        end
    end
    for _, child in pairs(char:GetChildren()) do
        if child:IsA("Tool") or child:IsA("Accessory") or child:IsA("Clothing") then
            child:Destroy()
        end
    end
    local desc = char:FindFirstChild("HumanoidDescription")
    if desc then
        desc:Destroy()
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = root
        task.wait(0.15)
        bv:Destroy()
    end
    local mt = getrawmetatable(Players)
    if mt and not self.oldPlayerIndex then
        self.oldPlayerIndex = mt.__index
        setreadonly(mt, false)
        mt.__index = function(t, k)
            if k == LocalPlayer then return nil end
            return self.oldPlayerIndex(t, k)
        end
        setreadonly(mt, true)
    end
end

function Shadow:restore(char)
    if not char then char = LocalPlayer.Character end
    if char then
        for part, props in pairs(self.originalParts) do
            if part and part.Parent then
                if part:IsA("BasePart") then
                    part.Transparency = props.Transparency
                    part.CanCollide = props.CanCollide
                    part.CanTouch = props.CanTouch
                    part.CanQuery = props.CanQuery
                    part.Color = props.Color
                    part.Material = props.Material
                    part.Reflectance = props.Reflectance
                elseif part:IsA("Decal") or part:IsA("Texture") then
                    part.Transparency = props.Transparency
                elseif part:IsA("Sound") then
                    part.Volume = props.Volume
                    part.Playing = props.Playing
                end
            end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = self.originalSpeed or 16
            hum.JumpPower = self.originalJump or 50
            hum.AutoRotate = true
        end
        local head = char:FindFirstChild("Head")
        if head then
            for g, en in pairs(self.originalBillboards) do
                if g and g.Parent then
                    g.Enabled = en
                end
            end
        end
        for _, tool in ipairs(self.originalTools) do
            if tool and tool.Parent == nil then tool.Parent = char end
        end
        for _, acc in ipairs(self.originalAccessories) do
            if acc and acc.Parent == nil then acc.Parent = char end
        end
        for _, cloth in ipairs(self.originalClothes) do
            if cloth and cloth.Parent == nil then cloth.Parent = char end
        end
        if self.originalDesc then
            local newDesc = self.originalDesc:Clone()
            newDesc.Parent = char
        end
    end
    if self.oldPlayerIndex then
        local mt = getrawmetatable(Players)
        setreadonly(mt, false)
        mt.__index = self.oldPlayerIndex
        setreadonly(mt, true)
        self.oldPlayerIndex = nil
    end
end

function Shadow:enable()
    if self.active then return end
    self.active = true
    local char = LocalPlayer.Character
    if char then
        self:saveOriginal(char)
        self:applyGhost(char)
    end
    if self.charConn then self.charConn:Disconnect() end
    self.charConn = LocalPlayer.CharacterAdded:Connect(function(newChar)
        task.wait(0.5)
        if Shadow.active then
            Shadow:saveOriginal(newChar)
            Shadow:applyGhost(newChar)
        end
    end)
end

function Shadow:disable()
    if not self.active then return end
    self.active = false
    local char = LocalPlayer.Character
    if char then self:restore(char) end
    if self.charConn then self.charConn:Disconnect(); self.charConn = nil end
end

