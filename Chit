-- Скрываем факт наличия executor'а
local function hide_executor_traces()
    local g = getgenv()
    local dangerous_globals = {
        "syn", "krnl", "scriptware", "delta", "protosmasher", "unc", 
        "identifyexecutor", "getexecutorname", "isexecutor", "check",
        "is_synapse_function", "is_scriptware", "is_krnl", "is_delta"
    }
    for _, name in ipairs(dangerous_globals) do
        if g[name] then g[name] = nil end
        if _G[name] then _G[name] = nil end
    end
    
    -- Перехват функций определения
    local old_getexecutorname = getexecutorname
    local old_isexecutor = isexecutor
    local old_identifyexecutor = identifyexecutor
    
    getexecutorname = function() return "Roblox" end
    isexecutor = function() return false end
    identifyexecutor = function() return "Roblox" end
    
    -- Подмена метатаблиц для game
    local mt = getrawmetatable(game)
    if mt then
        local old_namecall = mt.__namecall
        local old_index = mt.__index
        setreadonly(mt, false)
        
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            -- Блокируем вызовы, которые могут выдать чит
            if method == "FireServer" then
                local args = {...}
                if type(args[1]) == "string" and args[1]:lower():find("executor") then
                    return nil
                end
            end
            return old_namecall(self, ...)
        end)
        
        mt.__index = newcclosure(function(t, k)
            if k == "Platform" or k == "PlatformName" then
                return "Roblox"
            end
            if k == "Executor" or k == "ExecutionIdentity" then
                return nil
            end
            return old_index(t, k)
        end)
        
        setreadonly(mt, true)
    end
end

-- Блокировка телеметрии и отправки отчётов
local function kill_telemetry()
    local services_to_kill = {
        "TelemetryService", "AnalyticsService", "CrashReportService", 
        "BugReport", "PerformanceTracker", "LogService", "StatsService"
    }
    for _, svc_name in ipairs(services_to_kill) do
        local svc = game:FindFirstChild(svc_name)
        if svc then
            svc:Destroy()
        end
    end
    
    -- Перехват HttpService
    local http = game:GetService("HttpService")
    if http then
        local old_post = http.PostAsync
        local old_get = http.GetAsync
        http.PostAsync = function(self, url, data, ...)
            if type(url) == "string" and (url:find("telemetry") or url:find("analytics") or url:find("report")) then
                return ""
            end
            return old_post(self, url, data, ...)
        end
        http.GetAsync = function(self, url, ...)
            if type(url) == "string" and (url:find("telemetry") or url:find("analytics")) then
                return ""
            end
            return old_get(self, url, ...)
        end
    end
    
    -- Блокировка сетевой статистики (чтобы не палило подозрительный трафик)
    local stats = game:GetService("Stats")
    if stats and stats.Network then
        stats.Network:GetPropertyChangedSignal("OutgoingKBps"):Connect(function()
            stats.Network.OutgoingKBps = 0
        end)
        stats.Network:GetPropertyChangedSignal("IncomingKBps"):Connect(function()
            stats.Network.IncomingKBps = 0
        end)
    end
end

-- Маскировка под обычного игрока
local function fake_player_identity()
    local players = game:GetService("Players")
    local lp = players.LocalPlayer
    if lp then
        -- Смена MembershipType
        lp.MembershipType = Enum.MembershipType.None
        -- Сброс UserId (не всегда работает, но попытка)
        if lp:FindFirstChild("UserId") then
            lp.UserId = 0
        end
        -- Удаление подозрительных атрибутов
        if lp:FindFirstChild("ClientId") then
            lp.ClientId.Value = math.random(1000000, 9999999)
        end
        -- Отключаем все локальные скрипты античита
        for _, v in pairs(lp:GetChildren()) do
            if v:IsA("LocalScript") and (v.Name:lower():find("anticheat") or v.Name:lower():find("anti-cheat")) then
                v:Destroy()
            end
        end
    end
    -- Удаление глобальных античитов из ReplicatedStorage
    local replicated = game:GetService("ReplicatedStorage")
    if replicated then
        for _, v in pairs(replicated:GetChildren()) do
            if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
                if v.Name:lower():find("anti") or v.Name:lower():find("cheat") or v.Name:lower():find("report") then
                    v:Destroy()
                end
            end
        end
    end
end

-- Перехват и блокировка print/warn (чтобы не было логов в консоль Roblox)
local function hide_console_output()
    local old_print = print
    local old_warn = warn
    local old_error = error
    
    print = function(...)
        local args = {...}
        local str = tostring(table.concat(args, " "))
        if str:find("Executor") or str:find("Cheat") or str:find("exploit") or str:find("hack") then
            return
        end
        old_print(...)
    end
    
    warn = function(...)
        -- полностью отключаем warn
        return
    end
    
    error = function(...)
        local args = {...}
        local str = tostring(args[1])
        if str:find("executor") or str:find("cheat") then
            return
        end
        old_error(...)
    end
end

-- Запуск всех антидетектов
local function init_antidetect()
    hide_executor_traces()
    kill_telemetry()
    fake_player_identity()
    hide_console_output()
