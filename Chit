-- ФУНКЦИЯ 1: CHAT SPY (ПРОСМОТР ВСЕХ СООБЩЕНИЙ)
-- █████████████████████████████████████████████████████████████████████████████████████████████████████

local ChatSpy = {
    active = false,
    connections = {},
    original_say = nil,
    remote_event = nil
}

-- Перехватчик сообщений (работает даже если чат заблокирован или сообщения удаляются)
local function on_chat_message(sender, message)
    if not ChatSpy.active then return end
    local sender_name = (type(sender) == "string" and sender) or (sender and sender.Name) or "Unknown"
    local msg_text = tostring(message or "")
    -- Выводим в консоль (с цветом, если поддерживается)
    print(string.format("[CHATSPY] %s: %s", sender_name, msg_text))
    -- Также можно вывести в GUI (небольшое уведомление), но для простоты оставим консоль
    -- Пытаемся также продублировать в обычный чат (как своё сообщение, но не всегда возможно)
    local chat = game:GetService("Chat")
    if chat and chat:FindFirstChild("ChatInput") then
        -- Не будем спамить в чат, чтобы не выдать себя
    end
end

function ChatSpy:enable()
    if self.active then return end
    self.active = true
    
    -- Метод 1: Перехват удалённых событий (SayMessageRequest)
    local remote = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    if not remote then
        remote = ReplicatedStorage:FindFirstChild("SayMessageRequest")
    end
    if not remote then
        remote = ReplicatedStorage:FindFirstChild("Chatted")
    end
    if remote and remote:IsA("RemoteEvent") then
        self.remote_event = remote
        local old_fire = remote.FireServer
        remote.FireServer = function(...)
            local args = {...}
            if #args >= 2 then
                on_chat_message(LocalPlayer.Name, args[1])
            end
            return old_fire(...)
        end
        self.original_say = old_fire
    end
    
    -- Метод 2: Подписка на OnClientEvent (чужие сообщения)
    local chat_remote = ReplicatedStorage:FindFirstChild("OnChatMessage")
    if chat_remote and chat_remote:IsA("RemoteEvent") then
        local conn = chat_remote.OnClientEvent:Connect(on_chat_message)
        table.insert(self.connections, conn)
    end
    
    -- Метод 3: Перехват через TextChatService (новый Roblox чат)
    local text_chat = game:GetService("TextChatService")
    if text_chat then
        local chat_channels = text_chat:FindFirstChild("TextChannels")
        if chat_channels then
            for _, channel in pairs(chat_channels:GetChildren()) do
                if channel:IsA("TextChannel") then
                    local conn = channel.OnMessageReceived:Connect(function(msg)
                        if msg.FromSpeaker == LocalPlayer then return end
                        on_chat_message(msg.FromSpeaker.Name, msg.Text)
                    end)
                    table.insert(self.connections, conn)
                end
            end
        end
    end
    
    print("[ChatSpy] Включён. Все сообщения выводятся в консоль.")
end

function ChatSpy:disable()
    if not self.active then return end
    self.active = false
    for _, conn in ipairs(self.connections) do
        conn:Disconnect()
    end
    self.connections = {}
    if self.remote_event and self.original_say then
        self.remote_event.FireServer = self.original_say
        self.original_say = nil
    end
    print("[ChatSpy] Выключен.")
end

