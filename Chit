-- 8.1 Модификация leaderstats
function Zeus.modifyLeaderstats(value)
    local player = localPlayer
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in pairs(leaderstats:GetChildren()) do
            if stat:IsA("NumberValue") or stat:IsA("IntValue") then
                pcall(function()
                    stat.Value = value
                    Zeus.lastMoney = value
                end)
            end
        end
    else
        warn("[ZEUS] leaderstats не найдены, пробуем альтернативы")
        Zeus.alternativeMoneySearch(value)
    end
end

function Zeus.alternativeMoneySearch(value)
    for _, obj in pairs(game:GetDescendants()) do
        if obj:IsA("NumberValue") and string.match(obj.Name:lower(), "coin|money|cash|credit|gem|diamond") then
            pcall(function() obj.Value = value end)
        end
    end
end

-- 8.2 Блокировка уменьшения
local oldValueChanged = {}
function Zeus.blockMoneyReduction(enable)
    if enable then
        local player = localPlayer
        local leaderstats = player:FindFirstChild("leaderstats")
        if leaderstats then
            for _, stat in pairs(leaderstats:GetChildren()) do
                if stat:IsA("NumberValue") or stat:IsA("IntValue") then
                    local con = stat.Changed:Connect(function(newVal)
                        if newVal < (Zeus.lastMoney or 0) then
                            stat.Value = Zeus.lastMoney or 1e308
                        else
                            Zeus.lastMoney = newVal
                        end
                    end)
                    table.insert(Zeus.connections, con)
                end
            end
        end
    end
end

-- 8.3 Перехват удалённых событий
function Zeus.hijackRemotes()
    local remotes = {}
    for _, obj in pairs(replicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") and (string.match(obj.Name:lower(), "buy|purchase|shop|upgrade") or string.match(obj.Name:lower(), "money|coin")) then
            table.insert(remotes, obj)
        end
    end
    for _, remote in pairs(remotes) do
        local oldFunc = remote.OnClientEvent
        remote.OnClientEvent = function(...)
            local args = {...}
            -- Модифицируем аргументы с ценой, заменяя на 0 или отрицательное
            for i, arg in pairs(args) do
                if type(arg) == "number" and arg > 0 and arg < 1e7 then
                    args[i] = 0
                end
            end
            if oldFunc then oldFunc(unpack(args)) end
        end
    end
end

-- 8.4 Автофарм через удалённые события
Zeus.farmRemoteRunning = false
function Zeus.remoteFarm()
    Zeus.farmRemoteRunning = true
    local remotes = {}
    for _, obj in pairs(replicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") and string.match(obj.Name:lower(), "reward|collect|gain|addmoney") then
            table.insert(remotes, obj)
        end
    end
    spawn(function()
        while Zeus.farmRemoteRunning and Zeus.isActive do
            for _, remote in pairs(remotes) do
                pcall(function()
                    remote:FireServer("getReward", math.random(1000, 50000))
                end)
            end
            task.wait(0.05)
        end
    end)
end

-- 8.5 Динамический хук (инъекция в функции)
function Zeus.dynamicHook()
    local mt = getrawmetatable(game)
    local oldIndex = mt.__index
    setreadonly(mt, false)
    mt.__index = newcclosure(function(self, key)
        if key == "Value" or key == "Coins" or key == "Money" then
            return 9e99
        end
        return oldIndex(self, key)
    end)
    setreadonly(mt, true)
end

-- 8.6 Сканирование модулей
function Zeus.scanModules()
    for _, module in pairs(game:GetDescendants()) do
        if module:IsA("ModuleScript") then
            pcall(function()
                local env = getrenv()
                local oldRequire = env.require
                env.require = newcclosure(function(obj)
                    local result = oldRequire(obj)
                    if obj == module then
                        for k, v in pairs(result) do
                            if type(v) == "number" and v > 1000 then
                                result[k] = 1e308
                            end
                        end
                    end
                    return result
                end)
            end)
        end
    end
end

